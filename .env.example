# Copy to .env and fill in. Nothing here is committed (.env is gitignored).
# This file is company-agnostic: point it at any Jira Cloud site + GitHub repo.
# (The DEPUTY_ prefix is historical; the tool is tracker-agnostic now.)
# NOTE: quote any value containing spaces, e.g. FOO="a b c".

# --- Which tracker supplies work items ---
DEPUTY_TRACKER=jira          # jira | github

# --- Connection / credentials (required) ---
DEPUTY_USER_EMAIL=            # your Jira account email
DEPUTY_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
DEPUTY_CLOUD_ID=             # Jira Cloud id (GET https://your-site.atlassian.net/_edge/tenant_info)
DEPUTY_SITE_URL=             # e.g. https://your-team.atlassian.net (used to build ticket links)
DEPUTY_GITHUB_TOKEN=         # https://github.com/settings/tokens (repo scope)
DEPUTY_CLAUDE_API_KEY=       # optional: Anthropic API key. Omit to use Claude Code subscription auth.

# --- Which tickets to pick up ---
DEPUTY_PROJECTS=             # comma-separated project keys, e.g. SAAS (blank = all projects)
DEPUTY_LABEL=ai-ready        # pick up any ticket with this label (status-agnostic)

# --- Jira tracker: status moves for human-visible progress (pickup is by label) ---
DEPUTY_STATUS_START="In Progress"      # move here when work begins
DEPUTY_STATUS_DONE="In Review"         # move here when the PR is open

# --- GitHub Issues tracker (only used when TRACKER=github) ---
# Uses DEPUTY_LABEL above as the "ready" label, and DEPUTY_GITHUB_TOKEN.
DEPUTY_GITHUB_REPO=               # owner/name the issues live in, e.g. acme/app
DEPUTY_GITHUB_LABEL_STARTED=ai-in-progress   # label applied when work begins
DEPUTY_GITHUB_LABEL_DONE=ai-in-review        # label applied when the PR is open

# --- Behavior ---
DEPUTY_CHECK_INTERVAL=300    # seconds between Jira polls
# How the agent should verify its change. Keep it stack-agnostic; avoid apostrophes.
DEPUTY_TEST_INSTRUCTIONS="Run the automated tests relevant to your change (see README/CONTRIBUTING). Fix failures you introduced; ignore unrelated pre-existing ones."

# --- Worktree + agent (portable; nothing language/tool-specific is hardcoded) ---
# Command run in each fresh worktree to match the branch (deps install etc.). Blank = skip.
# e.g. "bundle install && yarn install", "npm ci", "pip install -r requirements.txt"
DEPUTY_WORKTREE_SETUP=
# Gitignored files to symlink from the main repo into each worktree.
DEPUTY_SYMLINK_FILES=".env .env.local"
# Command that does the work in each worktree; reads the task from $DEPUTY_PROMPT.
# Default is the bundled Claude Agent SDK runner. Point this at any other agent
# (aider, cursor-agent, …) so you are not locked to one tool.
DEPUTY_AGENT_CMD=
# Command eval'd right before the agent runs, e.g. refresh cloud creds. Blank = skip.
DEPUTY_PRE_AGENT=

# --- Follow-up work (CI auto-fix + continuations) ---
# Label deputy puts on its PRs; also how CI auto-fix finds which PRs to watch.
DEPUTY_PR_LABEL=ai-automated
# true = CI auto-fix posts a short "picking this up" comment on the PR (default: quiet).
DEPUTY_CI_ANNOUNCE=false

# --- Dashboard ---
DEPUTY_DASHBOARD_PORT=4319
# Comma-separated repo paths the dashboard may start a daemon in (blank = start from CLI only)
DEPUTY_REPOS=
