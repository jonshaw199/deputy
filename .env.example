# Copy to .env and fill in. Nothing here is committed (.env is gitignored).
# This file is company-agnostic: point it at any Jira Cloud site + GitHub repo.

# --- Connection / credentials (required) ---
JIRA_AUTOMATION_USER_EMAIL=            # your Jira account email
JIRA_AUTOMATION_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_AUTOMATION_CLOUD_ID=             # Jira Cloud id (GET https://your-site.atlassian.net/_edge/tenant_info)
JIRA_AUTOMATION_SITE_URL=             # e.g. https://your-team.atlassian.net (used to build ticket links)
JIRA_AUTOMATION_GITHUB_TOKEN=         # https://github.com/settings/tokens (repo scope)
JIRA_AUTOMATION_CLAUDE_API_KEY=       # optional: Anthropic API key. Omit to use Claude Code subscription auth.

# --- Which tickets to pick up ---
JIRA_AUTOMATION_PROJECTS=             # comma-separated project keys, e.g. SAAS (blank = all projects)
JIRA_AUTOMATION_LABEL=ai-ready        # only tickets with this label

# --- Your Jira workflow status names (defaults match a common flow) ---
JIRA_AUTOMATION_STATUS_READY=Groomed       # status that means "ready for the daemon to start"
JIRA_AUTOMATION_STATUS_START=In Progress   # move here when work begins
JIRA_AUTOMATION_STATUS_DONE=In Review      # move here when the PR is open

# --- Behavior ---
JIRA_AUTOMATION_CHECK_INTERVAL=300    # seconds between Jira polls
# How the agent should verify its change. Keep it stack-agnostic; avoid apostrophes.
JIRA_AUTOMATION_TEST_INSTRUCTIONS=Run the automated tests relevant to your change (see README/CONTRIBUTING). Fix failures you introduced; ignore unrelated pre-existing ones.

# --- Dashboard ---
JIRA_AUTOMATION_DASHBOARD_PORT=4319
# Comma-separated repo paths the dashboard may start a daemon in (blank = start from CLI only)
JIRA_AUTOMATION_REPOS=
