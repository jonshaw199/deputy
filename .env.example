# Copy to .env and fill in. Nothing here is committed (.env is gitignored).
# This file is company-agnostic: point it at any Jira Cloud site + GitHub repo.
# (The AIDAEMON_ prefix is historical; the tool is tracker-agnostic now.)

# --- Which tracker supplies work items ---
AIDAEMON_TRACKER=jira          # jira | github

# --- Connection / credentials (required) ---
AIDAEMON_USER_EMAIL=            # your Jira account email
AIDAEMON_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
AIDAEMON_CLOUD_ID=             # Jira Cloud id (GET https://your-site.atlassian.net/_edge/tenant_info)
AIDAEMON_SITE_URL=             # e.g. https://your-team.atlassian.net (used to build ticket links)
AIDAEMON_GITHUB_TOKEN=         # https://github.com/settings/tokens (repo scope)
AIDAEMON_CLAUDE_API_KEY=       # optional: Anthropic API key. Omit to use Claude Code subscription auth.

# --- Which tickets to pick up ---
AIDAEMON_PROJECTS=             # comma-separated project keys, e.g. SAAS (blank = all projects)
AIDAEMON_LABEL=ai-ready        # only tickets with this label

# --- Jira tracker: workflow status names (defaults match a common flow) ---
AIDAEMON_STATUS_READY=Groomed       # status that means "ready for the daemon to start"
AIDAEMON_STATUS_START=In Progress   # move here when work begins
AIDAEMON_STATUS_DONE=In Review      # move here when the PR is open

# --- GitHub Issues tracker (only used when TRACKER=github) ---
# Uses AIDAEMON_LABEL above as the "ready" label, and AIDAEMON_GITHUB_TOKEN.
AIDAEMON_GITHUB_REPO=               # owner/name the issues live in, e.g. acme/app
AIDAEMON_GITHUB_LABEL_STARTED=ai-in-progress   # label applied when work begins
AIDAEMON_GITHUB_LABEL_DONE=ai-in-review        # label applied when the PR is open

# --- Behavior ---
AIDAEMON_CHECK_INTERVAL=300    # seconds between Jira polls
# How the agent should verify its change. Keep it stack-agnostic; avoid apostrophes.
AIDAEMON_TEST_INSTRUCTIONS=Run the automated tests relevant to your change (see README/CONTRIBUTING). Fix failures you introduced; ignore unrelated pre-existing ones.

# --- Dashboard ---
AIDAEMON_DASHBOARD_PORT=4319
# Comma-separated repo paths the dashboard may start a daemon in (blank = start from CLI only)
AIDAEMON_REPOS=
