#!/bin/bash
# Deputy: watches a tracker (Jira / GitHub Issues) for ready, AI-labelled work items
# and resolves each autonomously: isolated git worktree -> implement -> push -> draft
# PR -> mark done. Also auto-fixes red CI on its own PRs and takes local follow-up
# requests. All config comes from .env (see .env.example).
#
# Usage (run from the repo you want the daemon to work on):
#   /path/to/deputy/bin/daemon start | stop | restart | status
#   /path/to/deputy/bin/daemon continue <TICKET> "<what to do next>"
#   /path/to/deputy/bin/daemon stop-ticket <TICKET>
#
# Logs:
#   tail -f ${RUNTIME_DIR}/deputy-<repo>.log                     # poller + outcomes
#   tail -f ${RUNTIME_DIR}/deputy-item-<TICKET>.log              # per-ticket (streaming)
#   tail -f ${RUNTIME_DIR}/deputy-item-<TICKET>-cont-<id>.log    # continuation (streaming)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DAEMON_BIN="$SCRIPT_DIR/daemon"
RUNNER_PATH="$PROJECT_ROOT/lib/claude-agent-runner.mjs"
TRACKER_CLI="$PROJECT_ROOT/lib/tracker-cli.mjs"
PR_WATCH="$PROJECT_ROOT/lib/pr-watch.mjs"
ROUTE_CLI="$PROJECT_ROOT/lib/route.mjs"
VERIFY_CLI="$PROJECT_ROOT/lib/verify.mjs"

source "$PROJECT_ROOT/config.sh"

# How work gets done, kept portable (nothing Claude/Ruby/company-specific is hardcoded):
#   DEPUTY_AGENT_CMD     - command run in each worktree; reads the task from $DEPUTY_PROMPT
#   DEPUTY_WORKTREE_SETUP- command run in each fresh worktree (deps install etc.); may be empty
#   DEPUTY_SYMLINK_FILES - gitignored files to symlink from the main repo into each worktree
#   DEPUTY_TEST_SETUP    - heavier setup to make a kept worktree runnable (e.g. a full build); run
#                          in the background after a case finishes so you can cd in and test the PR
AGENT_CMD="${DEPUTY_AGENT_CMD:-node \"$RUNNER_PATH\"}"
WORKTREE_SETUP="${DEPUTY_WORKTREE_SETUP:-}"
TEST_SETUP="${DEPUTY_TEST_SETUP:-}"
SYMLINK_FILES="${DEPUTY_SYMLINK_FILES:-.env .env.local}"
# Command eval'd right before the agent runs (e.g. refresh cloud creds); may be empty.
PRE_AGENT="${DEPUTY_PRE_AGENT:-}"
# Label put on deputy's PRs; also how CI auto-fix finds which PRs to watch.
PR_LABEL="${DEPUTY_PR_LABEL:-ai-automated}"
# Whether CI auto-fix posts a "picking this up" comment on the PR (default: quiet).
CI_ANNOUNCE="${DEPUTY_CI_ANNOUNCE:-false}"

# The daemon operates on the repo it is launched from.
MAIN_PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$MAIN_PROJECT_DIR")"
AUTOMATION_BASE_DIR="${MAIN_PROJECT_DIR}_deputy"

# Runtime files (logs, locks, markers) live here. Default /var/tmp — macOS clears /tmp on
# reboot but not /var/tmp, so case logs survive a restart. Must match the dashboard's DEPUTY_TMP.
RUNTIME_DIR="${DEPUTY_TMP:-/var/tmp}"
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true

# Checks the agent must run before committing — not just tests but the repo's lint/type/format,
# since red CI from a lint error is avoidable. Phrased to follow "run"; the agent finds the
# actual commands per repo. Override wholesale with DEPUTY_TEST_INSTRUCTIONS.
TEST_INSTRUCTIONS="the relevant tests AND the repo's linters, type-checks, and formatters (find the commands in package.json scripts, .github/workflows, or CLAUDE.md), fixing anything they flag (skip only pre-existing, unrelated failures)"
[ -n "$DEPUTY_TEST_INSTRUCTIONS" ] && TEST_INSTRUCTIONS="$DEPUTY_TEST_INSTRUCTIONS"

# Durable per-case journal (survives reboot — /tmp does not). Each case records what's
# needed to resume it: worktree, branch, base/stack, status, and its SDK session id.
CASES_DIR="${AUTOMATION_BASE_DIR}/cases"
journal_file() { echo "${CASES_DIR}/${1}.json"; }
session_file_for() { echo "${CASES_DIR}/${1}.session"; }
# Stacked-PR records live here (not /tmp) so they outlive the case journal and survive reboot;
# they must persist until the child PR merges, long after the child's own work is done.
STACKS_DIR="${AUTOMATION_BASE_DIR}/stacks"
stack_record() { echo "${STACKS_DIR}/${1}.json"; }
# write_journal <ticket> <status> <project> <worktree> <branch> <base_kind> <stack_branch> <stack_parent>
function write_journal() {
  mkdir -p "$CASES_DIR"
  jq -nc --arg t "$1" --arg s "$2" --arg p "$3" --arg w "$4" --arg b "$5" --arg bk "$6" --arg sb "$7" --arg sp "$8" \
    '{ticket:$t,status:$s,project:$p,worktree:$w,branch:$b,base_kind:$bk,stack_branch:$sb,stack_parent:$sp}' > "$(journal_file "$1")"
}
function set_journal_status() {
  local f; f=$(journal_file "$1"); [ -f "$f" ] || return 0
  jq --arg s "$2" '.status=$s' "$f" > "${f}.tmp" 2>/dev/null && mv -f "${f}.tmp" "$f"
}
function clear_journal() { rm -f "$(journal_file "$1")" "$(session_file_for "$1")"; }

DAEMON_PID_FILE="${RUNTIME_DIR}/deputy-${PROJECT_NAME}.pid"
DAEMON_LOG_FILE="${RUNTIME_DIR}/deputy-${PROJECT_NAME}.log"
DAEMON_META_FILE="${RUNTIME_DIR}/deputy-${PROJECT_NAME}.meta"
PROCESSED_FILE="${RUNTIME_DIR}/deputy-processed-${PROJECT_NAME}.txt"   # CI failures already handled (pr:sha)
ROUTED_FILE="${RUNTIME_DIR}/deputy-routed-${PROJECT_NAME}.txt"         # self-selection verdicts (ticket:yes|no|multi|done)
QUEUE_FILE="${RUNTIME_DIR}/deputy-queue-${PROJECT_NAME}.jsonl"         # local "do X next" requests
PRS_FILE="${RUNTIME_DIR}/deputy-prs-${PROJECT_NAME}.json"             # open PRs + unresolved review comments
CLAUDE_TIMEOUT_SECONDS=7200  # 2 hours

function kill_tree() {
  # Recursively kill a process and all its descendants (portable; no process groups).
  local p=$1
  local c
  for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done
  kill -9 "$p" 2>/dev/null || true
}

function preflight_tracker() {
  # Validates the configured tracker + credentials by doing one real poll.
  local out
  if ! out=$(node "$TRACKER_CLI" list-ready 2>&1); then
    echo "Tracker preflight failed:"
    echo "$out"
    echo "Check your .env (see .env.example)."
    exit 1
  fi
}

function ensure_deps() {
  # The Node runner imports the Agent SDK + zod from the automation dir's
  # node_modules (symlinked into each ticket worktree). Install only when missing.
  mkdir -p "$AUTOMATION_BASE_DIR"
  cd "$AUTOMATION_BASE_DIR"
  [ -f package.json ] || npm init -y >/dev/null 2>&1
  if [ ! -d node_modules/@anthropic-ai/claude-agent-sdk ] || [ ! -d node_modules/zod ]; then
    echo "Installing automation deps (claude-agent-sdk, zod)..."
    npm install --no-save @anthropic-ai/claude-agent-sdk zod >/dev/null 2>&1 || echo "WARN: npm install returned non-zero"
  fi
  cd "$MAIN_PROJECT_DIR"
}

function start_daemon() {
  if [ -f "$DAEMON_PID_FILE" ] && ps -p "$(cat "$DAEMON_PID_FILE")" >/dev/null 2>&1; then
    echo "Daemon already running (PID: $(cat "$DAEMON_PID_FILE"))"
    exit 1
  fi
  preflight_tracker
  ensure_deps

  echo "$MAIN_PROJECT_DIR" > "$DAEMON_META_FILE"
  echo "Starting daemon for $PROJECT_NAME (tracker: $(node "$TRACKER_CLI" name 2>/dev/null))..."
  nohup env -u CLAUDECODE "$DAEMON_BIN" __run > "$DAEMON_LOG_FILE" 2>&1 &
  echo $! > "$DAEMON_PID_FILE"
  echo "Daemon started (PID: $(cat "$DAEMON_PID_FILE"))"
  echo "Logs:      tail -f $DAEMON_LOG_FILE"
  echo "Dashboard: cd $PROJECT_ROOT && npm run dashboard"
}

function stop_daemon() {
  if [ ! -f "$DAEMON_PID_FILE" ]; then
    echo "Daemon not running"
    exit 1
  fi
  local pid; pid="$(cat "$DAEMON_PID_FILE")"
  echo "Stopping daemon and in-flight agents..."
  kill_tree "$pid"
  rm -f "$DAEMON_PID_FILE" "$DAEMON_META_FILE"
  echo "Daemon stopped"
}

function status_daemon() {
  if [ -f "$DAEMON_PID_FILE" ] && ps -p "$(cat "$DAEMON_PID_FILE")" >/dev/null 2>&1; then
    echo "Daemon running (PID: $(cat "$DAEMON_PID_FILE"))"
    echo "Logs: tail -f $DAEMON_LOG_FILE"
  else
    [ -f "$DAEMON_PID_FILE" ] && rm -f "$DAEMON_PID_FILE"
    echo "Daemon not running"
  fi
}

# One shared board can feed several repos' Deputies. Each asks itself — grounded in its own
# checkout — "is this ticket mine?" and only the right one(s) run with it. Verdicts are cached
# per ticket so the model is consulted once, not every poll. Returns 0 to work the ticket.
# Prints the cached verdict state (yes|multi) on stdout so the caller can tell sole from multi.
function route_gate() {
  local ticket=$1
  local cached; cached=$(grep "^${ticket}:" "$ROUTED_FILE" 2>/dev/null | tail -1 | cut -d: -f2)
  case "$cached" in
    yes|multi) echo "$cached"; return 0 ;;
    no|done)   return 1 ;;
  esac
  local repo_full; repo_full=$(cd "$MAIN_PROJECT_DIR" && gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
  env -u CLAUDECODE DEPUTY_SDK_DIR="$AUTOMATION_BASE_DIR/node_modules" node "$ROUTE_CLI" "$repo_full" "$ticket" "$MAIN_PROJECT_DIR" >>"$DAEMON_LOG_FILE" 2>&1
  case $? in
    0)  echo "${ticket}:yes"   >> "$ROUTED_FILE"; echo yes;   return 0 ;;
    10) echo "${ticket}:multi" >> "$ROUTED_FILE"; echo multi; return 0 ;;
    3)  echo "${ticket}:no" >> "$ROUTED_FILE"; echo "[$(date)] UNROUTED: $ticket (no confident owner here: $PROJECT_NAME)" >> "$DAEMON_LOG_FILE"; return 1 ;;
    *)  echo "${ticket}:no" >> "$ROUTED_FILE"; return 1 ;;
  esac
}

function watch_and_process() {
  # SIGUSR1 (sent by `continue` / the dashboard) drains the queue immediately
  # instead of waiting for the next poll.
  trap 'drain_continue_queue' USR1
  # Reconnect to any cases interrupted by a kill/restart/reboot before starting the poll loop.
  reconcile_cases
  while true; do
    echo "[$(date)] Checking for ready work items..."

    local tickets
    if ! tickets=$(node "$TRACKER_CLI" list-ready 2>>"$DAEMON_LOG_FILE"); then
      echo "[$(date)] tracker list-ready failed (see error above)"
      tickets=""
    fi

    if [ -n "$tickets" ]; then
      echo "[$(date)] Found tickets: $tickets"
      for ticket in $tickets; do
        local lock="${RUNTIME_DIR}/deputy-item-${ticket}.lock"
        if [ -f "$lock" ] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then
          echo "[$(date)] $ticket already processing; skipping"
          continue
        fi
        if ! route_gate "$ticket" >/dev/null; then
          echo "[$(date)] $ticket not routed to $PROJECT_NAME; skipping"
          continue
        fi
        echo "[$(date)] Processing $ticket in background... (logs: ${RUNTIME_DIR}/deputy-item-${ticket}.log)"
        process_ticket "$ticket" & echo $! > "$lock"
      done
    else
      echo "[$(date)] No tickets found"
    fi

    # Fix red CI on deputy's own PRs.
    check_for_ci_failures

    # Keep stacked (dependent) PRs rebased as their parent branches move or merge.
    maintain_stacks

    # Keep standalone PRs merge-ready: rebase + resolve when one conflicts with its base.
    check_for_conflicts

    # Keep open PRs from drifting too far behind their base (time-based; clean rebase, no agent).
    freshen_stale_branches

    # Remove Deputy's worktrees whose PR merged/closed (kept until then for local testing).
    prune_merged_worktrees

    # Publish open PRs + unresolved review comments for the dashboard (deputy never replies).
    # Write to a temp file and move it into place atomically so the dashboard never reads a
    # half-written/empty file mid-poll (which made in-review cases flicker). Keep the old file
    # if pr-watch fails (e.g. a transient gh hiccup) instead of blanking it.
    (cd "$MAIN_PROJECT_DIR" && node "$PR_WATCH" > "${PRS_FILE}.tmp" 2>/dev/null && mv -f "${PRS_FILE}.tmp" "$PRS_FILE") || rm -f "${PRS_FILE}.tmp"

    # Run any queued "do X next" / resume requests.
    drain_continue_queue

    # Interruptible sleep: a SIGUSR1 nudge (continue/dashboard) breaks out of this
    # immediately via the trap, instead of waiting out the whole interval.
    sleep "$CHECK_INTERVAL" & wait $! 2>/dev/null
  done
}

function setup_worktree() {
  local worktree=$1 log_file=$2
  echo "[$(date)] Setting up worktree..." >> "$log_file"

  # Symlink gitignored config files so the worktree shares live config
  for f in $SYMLINK_FILES; do
    [ -e "$MAIN_PROJECT_DIR/$f" ] || continue
    rm -f "$worktree/$f"
    ln -sf "$MAIN_PROJECT_DIR/$f" "$worktree/$f" 2>> "$log_file" || true
  done

  # Project-specific setup to match the branch (deps install, etc.); configurable, may be empty
  if [ -n "$WORKTREE_SETUP" ]; then
    echo "[$(date)] Running worktree setup: $WORKTREE_SETUP" >> "$log_file"
    (cd "$worktree" && eval "$WORKTREE_SETUP" >> "$log_file" 2>&1) \
      || echo "[$(date)] WARN: worktree setup returned non-zero" >> "$log_file"
  fi

  # Make the agent runtime deps resolvable in the worktree without clobbering installed deps
  mkdir -p "$worktree/node_modules"
  for dep in @anthropic-ai @modelcontextprotocol zod; do
    [ -e "$AUTOMATION_BASE_DIR/node_modules/$dep" ] || continue
    rm -rf "$worktree/node_modules/$dep"
    ln -sf "$AUTOMATION_BASE_DIR/node_modules/$dep" "$worktree/node_modules/$dep" 2>> "$log_file" || true
  done
}

# After a case finishes, make its kept worktree runnable so you can cd in and test the PR.
# Runs in the background (the PR is already up) and logs TEST-READY when done; the dashboard
# watches for that line. No-op unless DEPUTY_TEST_SETUP is set.
function prepare_worktree_for_testing() {
  local worktree=$1 log_file=$2
  [ -n "$TEST_SETUP" ] || return 0
  [ -d "$worktree" ] || return 0
  grep -q "TEST-READY: $worktree" "$log_file" 2>/dev/null && return 0  # already prepped
  local timeout="${DEPUTY_TEST_SETUP_TIMEOUT:-900}"  # cap so a hanging step (e.g. bin/update's server restart) can't stick on "preparing" forever
  (
    echo "[$(date)] Preparing worktree for local testing: $TEST_SETUP" >> "$log_file"
    ( cd "$worktree" && eval "$TEST_SETUP" >> "$log_file" 2>&1 ) &
    local sp=$!
    ( sleep "$timeout"; kill -0 "$sp" 2>/dev/null && { echo "[$(date)] Test setup still running after ${timeout}s — stopping it; deps are installed, so the worktree is usable (a later step like a server restart was left pending)." >> "$log_file"; kill_tree "$sp"; } ) & local wd=$!
    wait "$sp" 2>/dev/null
    kill "$wd" 2>/dev/null
    # TEST-READY = "prep finished" (not "succeeded"), so the dashboard stops showing "preparing".
    echo "[$(date)] TEST-READY: $worktree" >> "$log_file"
  ) &
}

function run_agent() {
  # run_agent <worktree> <prompt> <log_file> [input_file] [ask_file] [session_file] [resume_id]
  local worktree=$1 agent_prompt=$2 lf=$3 input_file=$4 ask_file=$5 session_file=$6 resume_id=$7
  [ -n "$PRE_AGENT" ] && eval "$PRE_AGENT" >> "$lf" 2>&1
  # The interrupt button (dashboard) drops this file; the runner watches for it. Derive it from
  # the input file (same ticket) and clear any stale signal before the agent starts.
  local interrupt_file=""
  if [ -n "$input_file" ]; then interrupt_file="${input_file/deputy-input-/deputy-interrupt-}"; interrupt_file="${interrupt_file%.jsonl}"; rm -f "$interrupt_file"; fi
  ( cd "$worktree" && env -u CLAUDECODE DEPUTY_PROMPT="$agent_prompt" \
      ${DEPUTY_GITHUB_TOKEN:+GITHUB_TOKEN="$DEPUTY_GITHUB_TOKEN"} \
      ${input_file:+DEPUTY_INPUT="$input_file"} \
      ${interrupt_file:+DEPUTY_INTERRUPT_FILE="$interrupt_file"} \
      ${ask_file:+DEPUTY_ASK_FILE="$ask_file"} \
      ${session_file:+DEPUTY_SESSION_FILE="$session_file"} \
      ${resume_id:+DEPUTY_RESUME="$resume_id"} \
      timeout "$CLAUDE_TIMEOUT_SECONDS" bash -c "$AGENT_CMD" >> "$lf" 2>&1 )
}

# continue_ticket <ticket_id> <prompt> <cont_id> [branch] [mode]
# Re-enters an existing PR's branch to do follow-up work (CI fix or a local request).
# Pass [branch] to target a specific PR branch (e.g. a random-named collaboration branch).
# mode=rebase runs the given prompt verbatim (for a stack rebase; the prompt force-pushes).
function continue_ticket() {
  local ticket_id=$1 continuation_prompt=$2 cont_id=$3 branch_override=$4 mode=$5
  local log_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-${cont_id}.log"
  local lock_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-${cont_id}.lock"
  local meta_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-${cont_id}.meta"  # so the case nests under its deputy
  local branch_name
  if [ -n "$branch_override" ]; then branch_name="$branch_override"
  else branch_name=$(echo "$USER/$ticket_id" | tr '[:upper:]' '[:lower:]'); fi
  local ticket_worktree="${AUTOMATION_BASE_DIR}_${ticket_id}_cont_${cont_id}"
  echo "$PROJECT_NAME" > "$meta_file"
  [ -f "${RUNTIME_DIR}/deputy-auto-${ticket_id}" ] && export DEPUTY_FULL_AUTO=1
  # The spawner records our real PID in the lock (for stop-ticket); we clear it on exit.
  trap "rm -f '$lock_file' '$meta_file'" EXIT

  echo "[$(date)] Continuation for $ticket_id (cont $cont_id)" > "$log_file"
  echo "[$(date)] Request: $continuation_prompt" >> "$log_file"
  cd "$MAIN_PROJECT_DIR" || { rm -f "$lock_file"; return 1; }

  # Reuse the branch's worktree if it's already checked out, else create one on the branch.
  local existing_worktree
  existing_worktree=$(git worktree list --porcelain | awk -v b="refs/heads/$branch_name" '/^worktree /{wt=substr($0,10)} $0=="branch " b{print wt}' | grep -v "^$MAIN_PROJECT_DIR$" | head -1)
  if [ -n "$existing_worktree" ]; then
    ticket_worktree="$existing_worktree"
    echo "[$(date)] Reusing worktree $ticket_worktree" >> "$log_file"
  else
    git worktree remove --force "$ticket_worktree" 2>/dev/null || true
    rm -rf "$ticket_worktree" 2>/dev/null || true
    git worktree prune 2>/dev/null || true
    git fetch origin "$branch_name" >> "$log_file" 2>&1 || true
    if ! git worktree add "$ticket_worktree" "$branch_name" >> "$log_file" 2>&1; then
      echo "[$(date)] FAILED continuation: $ticket_id (checkout $branch_name failed)" >> "$DAEMON_LOG_FILE"
      rm -f "$lock_file"; return 1
    fi
  fi

  setup_worktree "$ticket_worktree" "$log_file"

  local item_url; item_url=$(node "$TRACKER_CLI" url "$ticket_id" 2>/dev/null)
  local prompt
  if [ "$mode" = "rebase" ]; then
    prompt="$continuation_prompt

**Context:** You are in worktree $ticket_worktree on branch $branch_name (already checked out).
**Constraints:** Stay in the current directory (pwd). Do NOT use the Agent/Task tool."
  else
  prompt="Continue work on item $ticket_id.

**Request:**
$continuation_prompt
${item_url:+
**Work item:** $item_url}

**Context:**
- You are in an isolated worktree at $ticket_worktree, on branch $branch_name (already checked out).
- A PR already exists for this branch; commits you push appear on it automatically.
- Read the item with \`mcp__tracker__get_item\` (itemId: $ticket_id) if you need its details.

**Constraints:**
- Stay in the current directory (pwd). Do NOT create a new branch. Do NOT use the Agent/Task tool.

**Tasks:**
1. Address the request above.
2. If you changed code, run $TEST_INSTRUCTIONS (max 3 test reruns).
3. Commit with a descriptive message and push to origin/$branch_name.

Work autonomously. Report what you did."
  fi

  echo "[$(date)] Starting continuation agent for $ticket_id..." >> "$log_file"
  run_agent "$ticket_worktree" "$prompt" "$log_file"
  local exit_code=$?
  if [ $exit_code -eq 0 ]; then
    echo "[$(date)] SUCCESS continuation: $ticket_id (cont $cont_id)" >> "$DAEMON_LOG_FILE"
  else
    echo "[$(date)] FAILED continuation: $ticket_id (cont $cont_id, exit $exit_code)" >> "$DAEMON_LOG_FILE"
    # If the agent never ran at all (no [RESULT] in its log — e.g. a tool version the machine
    # lacks, or worktree setup failed), a CI/conflict attempt shouldn't stay marked "handled" or
    # it never retries once the env is fixed. Un-mark its sha so the next poll tries again.
    if { [[ "$cont_id" == conflict-* ]] || [[ "$cont_id" == ci-* ]]; } \
       && ! grep -q '\[RESULT\]' "$log_file" 2>/dev/null && [ -f "$PROCESSED_FILE" ]; then
      local sha8="${cont_id#*-}"
      grep -v ":${sha8}" "$PROCESSED_FILE" > "${PROCESSED_FILE}.tmp" 2>/dev/null && mv -f "${PROCESSED_FILE}.tmp" "$PROCESSED_FILE"
      echo "[$(date)] Setup/start failure — un-marked ${cont_id} so it retries next poll" >> "$DAEMON_LOG_FILE"
    fi
  fi

  # Only remove the worktree if we created it (don't nuke one the user is in).
  if [ -z "$existing_worktree" ]; then
    cd "$MAIN_PROJECT_DIR" && git worktree remove --force "$ticket_worktree" 2>/dev/null || rm -rf "$ticket_worktree"
    git worktree prune 2>/dev/null || true
  fi
  trap - EXIT; rm -f "$lock_file" "$meta_file"
}

# Watches deputy's own open PRs (by label) for red CI and auto-triggers a fix. Forge = GitHub.
function check_for_ci_failures() {
  command -v gh >/dev/null 2>&1 || return 0
  local pr_list
  pr_list=$(cd "$MAIN_PROJECT_DIR" && gh pr list --state open --label "$PR_LABEL" --json number,headRefName,headRefOid 2>/dev/null) || return 0
  local rows
  rows=$(echo "$pr_list" | jq -r '.[] | [(.number|tostring), .headRefName, .headRefOid] | @tsv' 2>/dev/null)
  [ -z "$rows" ] && return 0

  while IFS=$'\t' read -r pr_number branch_name commit_sha; do
    [ -z "$pr_number" ] && continue
    local key="ci:${pr_number}:${commit_sha}"
    grep -qF "$key" "$PROCESSED_FILE" 2>/dev/null && continue

    # NOTE: `gh pr checks` exits non-zero when checks are failing/pending — do NOT bail on
    # that, or we'd skip exactly the red PRs we need to fix. Judge by the JSON instead.
    local checks
    checks=$(cd "$MAIN_PROJECT_DIR" && gh pr checks "$pr_number" --json name,state,link 2>/dev/null)
    [ -z "$checks" ] && continue
    local pending; pending=$(echo "$checks" | jq '[.[]|select(.state=="PENDING" or .state=="IN_PROGRESS")]|length' 2>/dev/null || echo 0)
    local failed; failed=$(echo "$checks" | jq '[.[]|select(.state=="FAIL" or .state=="FAILURE")]|length' 2>/dev/null || echo 0)
    { [ "$pending" -gt 0 ] || [ "$failed" -gt 0 ]; } && echo "[$(date)] CI check PR #$pr_number (${branch_name}): pending=$pending failed=$failed" >> "$DAEMON_LOG_FILE"
    [ "$pending" -gt 0 ] && continue
    [ "$failed" -eq 0 ] && continue

    echo "$key" >> "$PROCESSED_FILE"
    local ticket_id; ticket_id=$(echo "$branch_name" | sed 's|.*/||' | tr '[:lower:]' '[:upper:]')
    echo "[$(date)] CI auto-fix: PR #$pr_number ($ticket_id) has $failed failed checks at ${commit_sha:0:8}" >> "$DAEMON_LOG_FILE"

    local summary; summary=$(echo "$checks" | jq -r '.[]|select(.state=="FAIL" or .state=="FAILURE")|"- \(.name): \(.link // "")"')
    local repo; repo=$(cd "$MAIN_PROJECT_DIR" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
    local annotations=""
    while IFS= read -r link; do
      local run_id; run_id=$(echo "$link" | grep -o '[0-9]*$'); [ -z "$run_id" ] && continue
      local a; a=$(cd "$MAIN_PROJECT_DIR" && gh api "repos/$repo/check-runs/$run_id/annotations" --jq '.[]|"  [\(.path):\(.start_line)] \(.message|split("\n")[0])"' 2>/dev/null | head -20)
      [ -n "$a" ] && annotations="${annotations}
Run $run_id:
$a"
    done < <(echo "$checks" | jq -r '.[]|select(.state=="FAIL" or .state=="FAILURE")|.link // empty')

    [ "$CI_ANNOUNCE" = "true" ] && (cd "$MAIN_PROJECT_DIR" && gh pr comment "$pr_number" --body "🤖 CI failed on \`${commit_sha:0:8}\` — picking it up." >> "$DAEMON_LOG_FILE" 2>&1)

    local prompt="CI checks are failing on PR #$pr_number (branch $branch_name).

Failed checks:
$summary
${annotations:+
Annotations (file:line + message):
$annotations}

Triage each failing check before changing anything:
1. Run \`git diff origin/main...HEAD --name-only\` to see what this branch changed.
2. Classify each failure as related (introduced by this branch) or unrelated (flaky/infra/pre-existing on main).
3. Fix only the related failures (reproduce locally, fix root cause in code not tests, push).
4. If all failures are unrelated, do nothing and say so."

    local clock="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-ci-${commit_sha:0:8}.lock"
    continue_ticket "$ticket_id" "$prompt" "ci-${commit_sha:0:8}" & echo $! > "$clock"
  done <<< "$rows"
}

# Keep deputy's open PRs merge-ready: when one conflicts with its base (main drifted under it),
# rebase it onto the base and hand the conflict to the agent to resolve — same machinery stacks
# use, but triggered by conflict-with-base instead of a parent merge. Toggle: DEPUTY_CONFLICT_AUTORESOLVE.
function check_for_conflicts() {
  [ "${DEPUTY_CONFLICT_AUTORESOLVE:-true}" = "true" ] || return 0
  command -v gh >/dev/null 2>&1 || return 0
  local pr_list
  pr_list=$(cd "$MAIN_PROJECT_DIR" && gh pr list --state open --label "$PR_LABEL" --json number,headRefName,headRefOid,baseRefName,mergeable 2>/dev/null) || return 0
  local rows
  # Only CONFLICTING; UNKNOWN means GitHub is still computing mergeability — recheck next poll.
  rows=$(echo "$pr_list" | jq -r '.[] | select(.mergeable=="CONFLICTING") | [(.number|tostring), .headRefName, .headRefOid, .baseRefName] | @tsv' 2>/dev/null)
  [ -z "$rows" ] && return 0

  while IFS=$'\t' read -r pr_number branch_name commit_sha base_ref; do
    [ -z "$pr_number" ] && continue
    local key="conflict:${pr_number}:${commit_sha}"
    grep -qF "$key" "$PROCESSED_FILE" 2>/dev/null && continue   # already attempted this head; a new push re-checks

    local ticket_id; ticket_id=$(echo "$branch_name" | sed 's|.*/||' | tr '[:lower:]' '[:upper:]')
    # Let the stack flow own a still-stacked child; don't touch a busy/parked/blocked case.
    [ -f "$(stack_record "$ticket_id")" ] && continue
    { [ -f "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" ] && kill -0 "$(cat "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" 2>/dev/null)" 2>/dev/null; } && continue
    local alive=0 cl
    for cl in ${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-*.lock; do
      [ -e "$cl" ] || continue; kill -0 "$(cat "$cl" 2>/dev/null)" 2>/dev/null && { alive=1; break; }
    done
    [ "$alive" = 1 ] && continue
    [ -f "${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt" ] && continue
    [ -f "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.meta" ] && continue
    # A foreign worktree holding the branch means a human is on it — leave it alone.
    local cwt; cwt=$(worktree_for_branch "$branch_name")
    { [ -n "$cwt" ] && [[ "$cwt" != "${AUTOMATION_BASE_DIR}_"* ]]; } && continue

    echo "$key" >> "$PROCESSED_FILE"
    echo "[$(date)] Conflict auto-resolve: PR #$pr_number ($ticket_id) conflicts with $base_ref at ${commit_sha:0:8}" >> "$DAEMON_LOG_FILE"

    local prompt="PR #$pr_number (branch \`$branch_name\`) has merge conflicts with its base (\`origin/$base_ref\`); the base moved under it.

Rebase it onto the latest base and resolve the conflicts:
1. \`git fetch origin $base_ref\`
2. \`git rebase origin/$base_ref\`
3. Resolve every conflict — THIS branch's own changes MUST survive; re-apply their intent on top of the new base, do NOT drop them.
4. Run $TEST_INSTRUCTIONS.
5. \`git push --force-with-lease origin $branch_name\`
If you cannot resolve safely, run \`git rebase --abort\`, do NOT push, and clearly report that a human is needed."

    local clock="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-conflict-${commit_sha:0:8}.lock"
    continue_ticket "$ticket_id" "$prompt" "conflict-${commit_sha:0:8}" "$branch_name" rebase & echo $! > "$clock"
  done <<< "$rows"
}

# Keep open PRs from drifting too far behind their base. Staleness is measured in TIME, not a fixed
# commit count (20 commits is hours in a busy repo, weeks in a quiet one): a branch is stale when its
# fork point is more than DEPUTY_FRESHEN_MAX_DAYS of base history old. A clean rebase is mechanical, so
# the daemon does it directly (no agent, no tokens); anything that conflicts is left for the conflict
# watcher. Gated per head sha so each drift is handled once, not re-pushed every poll (which would thrash
# CI). Global default in .env, overridable per-repo via that repo's .env.local.
function freshen_stale_branches() {
  [ "${DEPUTY_FRESHEN:-true}" = "true" ] || return 0
  command -v gh >/dev/null 2>&1 || return 0
  local max_days="${DEPUTY_FRESHEN_MAX_DAYS:-2}"
  local pr_list
  pr_list=$(cd "$MAIN_PROJECT_DIR" && gh pr list --state open --label "$PR_LABEL" --json number,headRefName,headRefOid,baseRefName,mergeable 2>/dev/null) || return 0
  local rows
  # Skip CONFLICTING (the conflict watcher owns those) and UNKNOWN (GitHub still computing).
  rows=$(echo "$pr_list" | jq -r '.[] | select(.mergeable=="MERGEABLE") | [(.number|tostring), .headRefName, .headRefOid, .baseRefName] | @tsv' 2>/dev/null)
  [ -z "$rows" ] && return 0
  cd "$MAIN_PROJECT_DIR" || return 0

  while IFS=$'\t' read -r pr_number branch_name commit_sha base_ref; do
    [ -z "$pr_number" ] && continue
    local key="freshen:${pr_number}:${commit_sha}"
    grep -qF "$key" "$PROCESSED_FILE" 2>/dev/null && continue

    git fetch origin "$base_ref" "$branch_name" >/dev/null 2>&1
    local mb base_t mb_t days
    mb=$(git merge-base "origin/$base_ref" "origin/$branch_name" 2>/dev/null)
    [ -z "$mb" ] && continue
    base_t=$(git show -s --format=%ct "origin/$base_ref" 2>/dev/null)
    mb_t=$(git show -s --format=%ct "$mb" 2>/dev/null)
    { [ -z "$base_t" ] || [ -z "$mb_t" ]; } && continue
    days=$(( (base_t - mb_t) / 86400 ))
    [ "$days" -lt "$max_days" ] && continue

    local ticket_id; ticket_id=$(echo "$branch_name" | sed 's|.*/||' | tr '[:lower:]' '[:upper:]')
    # maintain_stacks owns stacked branches; don't touch a busy/parked/blocked case or a human's worktree.
    [ -f "$(stack_record "$ticket_id")" ] && continue
    { [ -f "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" ] && kill -0 "$(cat "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" 2>/dev/null)" 2>/dev/null; } && continue
    local alive=0 cl
    for cl in ${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-*.lock; do
      [ -e "$cl" ] || continue; kill -0 "$(cat "$cl" 2>/dev/null)" 2>/dev/null && { alive=1; break; }
    done
    [ "$alive" = 1 ] && continue
    [ -f "${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt" ] && continue
    [ -f "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.meta" ] && continue
    local cwt; cwt=$(worktree_for_branch "$branch_name")
    { [ -n "$cwt" ] && [[ "$cwt" != "${AUTOMATION_BASE_DIR}_"* ]]; } && continue

    echo "$key" >> "$PROCESSED_FILE"
    echo "[$(date)] Freshen: PR #$pr_number ($ticket_id) forked ~${days}d behind $base_ref; rebasing (daemon)" >> "$DAEMON_LOG_FILE"

    # Rebase in Deputy's kept worktree if it has one, else a throwaway worktree.
    local wt="$cwt" temp=0
    if [ -z "$wt" ] || [ ! -d "$wt" ]; then
      wt="${AUTOMATION_BASE_DIR}_${ticket_id}_freshen"; temp=1
      git worktree remove --force "$wt" 2>/dev/null; rm -rf "$wt" 2>/dev/null
      git worktree add --force "$wt" "$branch_name" >/dev/null 2>&1 || { git worktree prune 2>/dev/null; continue; }
    fi
    if ( cd "$wt" && git rebase "origin/$base_ref" >/dev/null 2>&1 ); then
      if ( cd "$wt" && git push --force-with-lease origin "$branch_name" >/dev/null 2>&1 ); then
        echo "[$(date)] Freshen: PR #$pr_number rebased onto $base_ref + pushed" >> "$DAEMON_LOG_FILE"
      else
        echo "[$(date)] Freshen: PR #$pr_number rebase ok but push failed (will retry next drift)" >> "$DAEMON_LOG_FILE"
      fi
    else
      ( cd "$wt" && git rebase --abort >/dev/null 2>&1 )
      echo "[$(date)] Freshen: PR #$pr_number rebase hit conflicts; leaving it for the conflict watcher" >> "$DAEMON_LOG_FILE"
    fi
    [ "$temp" = 1 ] && { git worktree remove --force "$wt" 2>/dev/null; git worktree prune 2>/dev/null; }
  done <<< "$rows"
}

# True when a branch is checked out in a worktree other than the main repo (you're in it).
function branch_checked_out_elsewhere() {
  local branch=$1
  cd "$MAIN_PROJECT_DIR" && git worktree list --porcelain \
    | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0=="branch " b{print w}' \
    | grep -qv "^$MAIN_PROJECT_DIR\$"
}

# resync_stack <ticket> <parent_branch> <child_branch> <oldbase_sha> <newbase_ref> <update|retarget>
# Rebases a stacked child so it sits on the current parent (or on main once the parent
# merged). Clean rebase -> force-push automatically; a conflict is handed to the agent.
function resync_stack() {
  local ticket_id=$1 parent_branch=$2 child_branch=$3 oldbase=$4 newbase_ref=$5 mode=$6
  local lock_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-sync.lock"
  local meta_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-sync.meta"
  local log_file="${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-sync.log"
  local sf; sf=$(stack_record "$ticket_id")
  echo "$PROJECT_NAME" > "$meta_file"
  trap "rm -f '$lock_file' '$meta_file'" EXIT

  echo "[$(date)] Rebase $child_branch --onto $newbase_ref (drop $oldbase, mode=$mode)" > "$log_file"
  cd "$MAIN_PROJECT_DIR" || { rm -f "$lock_file"; return 1; }

  # Rebase in deputy's own kept worktree when the branch lives in one (so it stays current for
  # local testing); otherwise spin a throwaway sync worktree. Foreign worktrees never reach here.
  local wt own=1; wt=$(worktree_for_branch "$child_branch")
  if [ -z "$wt" ] || [[ "$wt" != "${AUTOMATION_BASE_DIR}_"* ]]; then
    own=0; wt="${AUTOMATION_BASE_DIR}_${ticket_id}_sync"
    git worktree remove --force "$wt" 2>/dev/null || true; rm -rf "$wt" 2>/dev/null || true
    git worktree prune 2>/dev/null || true
  fi

  git fetch origin "$child_branch" >> "$log_file" 2>&1 || true
  git fetch origin main >> "$log_file" 2>&1 || true
  [ "$mode" = "update" ] && { git fetch origin "$parent_branch" >> "$log_file" 2>&1 || true; }

  if [ "$own" -eq 0 ]; then
    if ! git worktree add -B "$child_branch" "$wt" "origin/$child_branch" >> "$log_file" 2>&1; then
      echo "[$(date)] Stack resync FAILED: $ticket_id (cannot checkout $child_branch)" >> "$DAEMON_LOG_FILE"
      return 1
    fi
    setup_worktree "$wt" "$log_file"
  else
    git -C "$wt" reset --hard "origin/$child_branch" >> "$log_file" 2>&1 || true
  fi

  # Retarget the PR base first (idempotent); the diff tidies once the rebased branch lands.
  [ "$mode" = "retarget" ] && { (cd "$MAIN_PROJECT_DIR" && gh pr edit "$child_branch" --base main >> "$log_file" 2>&1) || true; }

  if git -C "$wt" rebase --onto "$newbase_ref" "$oldbase" >> "$log_file" 2>&1; then
    git -C "$wt" push --force-with-lease origin "$child_branch" >> "$log_file" 2>&1
    if [ "$mode" = "retarget" ]; then
      rm -f "$sf"
      echo "[$(date)] Stack: $ticket_id rebased onto main + PR retargeted (parent $parent_branch merged)" >> "$DAEMON_LOG_FILE"
    else
      local newsha; newsha=$(git -C "$wt" rev-parse "$newbase_ref" 2>/dev/null)
      jq --arg s "$newsha" '.last_parent_sha=$s' "$sf" > "${sf}.tmp" 2>/dev/null && mv -f "${sf}.tmp" "$sf"
      echo "[$(date)] Stack: $ticket_id rebased on updated $parent_branch @ ${newsha:0:8}" >> "$DAEMON_LOG_FILE"
    fi
    [ "$own" -eq 0 ] && { cd "$MAIN_PROJECT_DIR" && git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; git worktree prune 2>/dev/null || true; }
  else
    # Rare: the rebase conflicts. Abort to a clean state and hand it to the agent to resolve.
    git -C "$wt" rebase --abort >> "$log_file" 2>&1 || true
    [ "$own" -eq 0 ] && { cd "$MAIN_PROJECT_DIR" && git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; git worktree prune 2>/dev/null || true; }
    echo "[$(date)] Stack: $ticket_id rebase conflicted; handing to the agent" >> "$DAEMON_LOG_FILE"
    local target_base="$newbase_ref"; [ "$mode" = "retarget" ] && target_base="origin/main"
    local rp="Rebase branch $child_branch so it sits cleanly on top of $target_base.

Run \`git fetch origin\`, then \`git rebase --onto $target_base $oldbase $child_branch\`.
Resolve every merge conflict (this branch's own changes MUST survive), run $TEST_INSTRUCTIONS,
then \`git push --force-with-lease origin $child_branch\`. If you cannot resolve the conflicts
safely, run \`git rebase --abort\`, do NOT push, and clearly report that a human is needed."
    trap - EXIT; rm -f "$meta_file"
    continue_ticket "$ticket_id" "$rp" "sync" "$child_branch" rebase & echo $! > "$lock_file"
    return 0
  fi
  trap - EXIT; rm -f "$lock_file" "$meta_file"
}

# Removes Deputy's own worktrees once their PR has merged/closed, so disk stays bounded to
# open PRs (we keep them until then so you can cd in and test locally). Only touches worktrees
# Deputy created (`<repo>_deputy_*`), never yours; --force since they carry build artifacts.
function prune_merged_worktrees() {
  command -v gh >/dev/null 2>&1 || return 0
  cd "$MAIN_PROJECT_DIR" || return 0
  local path branch short state ticket lock
  while IFS=$'\t' read -r path branch; do
    { [ -z "$path" ] || [ -z "$branch" ]; } && continue
    case "$path" in "${AUTOMATION_BASE_DIR}_"*) ;; *) continue ;; esac   # only Deputy's own worktrees
    short="${branch#refs/heads/}"
    state=$(gh pr list --head "$short" --state all --json state --jq '.[0].state // empty' 2>/dev/null)
    { [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ]; } || continue
    ticket=$(echo "$short" | sed 's|.*/||' | tr '[:lower:]' '[:upper:]')
    lock="${RUNTIME_DIR}/deputy-item-${ticket}.lock"
    { [ -f "$lock" ] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; } && continue  # live; leave it
    if git worktree remove --force "$path" 2>>"$DAEMON_LOG_FILE"; then
      git branch -D "$short" >/dev/null 2>&1 || true
      clear_journal "$ticket"
      rm -f "$(stack_record "$ticket")" "${RUNTIME_DIR}/deputy-stopped-${ticket}.meta" \
            "${RUNTIME_DIR}/deputy-failed-${ticket}.meta" "${RUNTIME_DIR}/deputy-failed-${ticket}.txt"
      echo "[$(date)] Pruned $ticket worktree (PR $state): $path" >> "$DAEMON_LOG_FILE"
    fi
  done < <(git worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch /{print p"\t"substr($0,8)} /^$/{p=""}')
  git worktree prune 2>/dev/null || true
}

# Keeps stacked children fresh: when a parent branch moves, rebase the child on it; when a
# parent merges, rebase the child onto main and retarget its PR. Skips children that are
# busy, parked, blocked, or checked out in your own worktree (never rebase under you).
function maintain_stacks() {
  [ "${DEPUTY_STACK_AUTOSYNC:-true}" = "true" ] || return 0
  command -v gh >/dev/null 2>&1 || return 0
  local sf ticket sproj parent_branch child_branch oldbase
  for sf in "${STACKS_DIR}"/*.json; do
    [ -f "$sf" ] || continue
    sproj=$(jq -r '.project // empty' "$sf" 2>/dev/null)
    [ "$sproj" = "$PROJECT_NAME" ] || continue
    ticket=$(basename "$sf" .json)

    # Don't touch a child that is actively working, parked, or blocked.
    local clock="${RUNTIME_DIR}/deputy-item-${ticket}.lock" synclock="${RUNTIME_DIR}/deputy-item-${ticket}-cont-sync.lock"
    { [ -f "$clock" ] && kill -0 "$(cat "$clock" 2>/dev/null)" 2>/dev/null; } && continue
    { [ -f "$synclock" ] && kill -0 "$(cat "$synclock" 2>/dev/null)" 2>/dev/null; } && continue
    [ -f "${RUNTIME_DIR}/deputy-ask-${ticket}.txt" ] && continue
    [ -f "${RUNTIME_DIR}/deputy-blocked-${ticket}.meta" ] && continue

    parent_branch=$(jq -r '.parent_branch // empty' "$sf")
    child_branch=$(jq -r '.child_branch // empty' "$sf")
    oldbase=$(jq -r '.last_parent_sha // empty' "$sf")
    { [ -z "$parent_branch" ] || [ -z "$child_branch" ] || [ -z "$oldbase" ]; } && continue
    # Skip only if a *foreign* worktree holds the branch (a human is collaborating). Deputy's own
    # kept worktree is fine — resync_stack rebases in place there.
    local cwt; cwt=$(worktree_for_branch "$child_branch")
    { [ -n "$cwt" ] && [[ "$cwt" != "${AUTOMATION_BASE_DIR}_"* ]]; } && continue

    # Child PR gone/merged -> stack is done.
    local child_open; child_open=$(cd "$MAIN_PROJECT_DIR" && gh pr list --head "$child_branch" --state open --json number --jq 'length' 2>/dev/null)
    if [ "${child_open:-0}" = "0" ]; then rm -f "$sf"; continue; fi

    local parent_json; parent_json=$(cd "$MAIN_PROJECT_DIR" && gh pr list --head "$parent_branch" --state all --json state,headRefOid --jq '.[0] // {}' 2>/dev/null)
    local pstate psha
    pstate=$(echo "$parent_json" | jq -r '.state // empty' 2>/dev/null)
    psha=$(echo "$parent_json" | jq -r '.headRefOid // empty' 2>/dev/null)

    if [ "$pstate" = "MERGED" ]; then
      resync_stack "$ticket" "$parent_branch" "$child_branch" "$oldbase" "origin/main" retarget & echo $! > "$synclock"
    elif [ "$pstate" = "OPEN" ] && [ -n "$psha" ] && [ "$psha" != "$oldbase" ]; then
      resync_stack "$ticket" "$parent_branch" "$child_branch" "$oldbase" "origin/$parent_branch" update & echo $! > "$synclock"
    fi
  done
}

# Drains local "do X next" requests (CLI or dashboard) into the continue engine.
function drain_continue_queue() {
  [ -s "$QUEUE_FILE" ] || return 0
  local tmp; tmp=$(mktemp)
  mv "$QUEUE_FILE" "$tmp"
  local line
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local ticket prompt cid kind branch
    ticket=$(echo "$line" | jq -r '.ticket // empty' 2>/dev/null)
    prompt=$(echo "$line" | jq -r '.prompt // empty' 2>/dev/null)
    cid=$(echo "$line" | jq -r '.id // empty' 2>/dev/null)
    kind=$(echo "$line" | jq -r '.kind // "continue"' 2>/dev/null)
    branch=$(echo "$line" | jq -r '.branch // empty' 2>/dev/null)
    { [ -z "$ticket" ] || [ -z "$prompt" ]; } && continue
    [ -z "$cid" ] && cid="q$(echo "$line" | cksum | cut -d' ' -f1)"
    if [ "$kind" = "rerun" ]; then
      echo "[$(date)] Re-run request for $ticket" >> "$DAEMON_LOG_FILE"
      local rlock="${RUNTIME_DIR}/deputy-item-${ticket}.lock"
      resume_or_restart "$ticket" & echo $! > "$rlock"
    elif [ "$kind" = "resume" ]; then
      echo "[$(date)] Resume request for $ticket" >> "$DAEMON_LOG_FILE"
      local rlock="${RUNTIME_DIR}/deputy-item-${ticket}.lock"
      resume_ticket "$ticket" "$prompt" & echo $! > "$rlock"
    else
      echo "[$(date)] Local continuation request for $ticket (cont $cid)" >> "$DAEMON_LOG_FILE"
      local clock="${RUNTIME_DIR}/deputy-item-${ticket}-cont-${cid}.lock"
      continue_ticket "$ticket" "$prompt" "$cid" "$branch" & echo $! > "$clock"
    fi
  done < "$tmp"
  rm -f "$tmp"
}

# Appends a queued request to this project's queue (drained by the running daemon).
function enqueue_request() {
  local ticket=$1 prompt=$2 kind=$3 usage=$4
  if [ -z "$ticket" ] || [ -z "$prompt" ]; then echo "$usage"; exit 1; fi
  jq -nc --arg t "$ticket" --arg p "$prompt" --arg k "$kind" --arg id "cli-$(date +%s)-$$" \
    '{ticket:$t, prompt:$p, kind:$k, id:$id}' >> "$QUEUE_FILE"
  # Nudge the running daemon to drain the queue now (instead of waiting for the poll).
  local dpid; dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  if [ -n "$dpid" ] && kill -USR1 "$dpid" 2>/dev/null; then
    echo "Queued $kind for $ticket (daemon notified; picking it up now)."
  else
    echo "Queued $kind for $ticket (no running daemon; it will run on next start)."
  fi
}
function enqueue_continue() { enqueue_request "$1" "$2" continue "Usage: deputy continue <TICKET> \"<what to do>\""; }
function enqueue_resume()   { enqueue_request "$1" "$2" resume   "Usage: deputy resume <TICKET> \"<your answer>\""; }
# Re-run a stopped/failed case (▶): resume its session, finish its PR, or start fresh.
function enqueue_rerun() {
  local ticket=$1; [ -z "$ticket" ] && { echo "Usage: deputy rerun <TICKET>"; exit 1; }
  jq -nc --arg t "$ticket" --arg k rerun --arg p rerun --arg id "cli-$(date +%s)-$$" '{ticket:$t,kind:$k,prompt:$p,id:$id}' >> "$QUEUE_FILE"
  local dpid; dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  if [ -n "$dpid" ] && kill -USR1 "$dpid" 2>/dev/null; then echo "Re-running $ticket."; else echo "Queued rerun for $ticket (runs on next start)."; fi
}

# worktree_for_branch <branch>
# Prints the path of the worktree where <branch> is checked out (other than the main repo),
# or empty. git only allows a branch in one worktree, so this is who to reuse.
function worktree_for_branch() {
  local branch=$1
  [ -z "$branch" ] && return 0
  cd "$MAIN_PROJECT_DIR" && git worktree list --porcelain \
    | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0=="branch " b{print w}' \
    | grep -v "^$MAIN_PROJECT_DIR\$" | head -1
}

# The set of files the agent actually authored this run — the paths from its Write/Edit tool calls
# (NOT Read), made repo-relative. This is "what's relevant to the ticket": anything else dirty in the
# worktree (structure.sql, lockfiles, any generated/environmental file in any repo) was produced by
# setup or tests, not authored by the agent, and must not be committed. Fully generic — no file names.
function agent_edited_files() {
  local log_file=$1 worktree=$2
  [ -f "$log_file" ] || return 0
  awk '
    /━━━ \[(Write|Edit)\] ━━━/ { w=1; next }
    w { if (match($0, /"file_path":"[^"]+"/)) print substr($0, RSTART+13, RLENGTH-14); w=0 }
  ' "$log_file" 2>/dev/null | grep -F "$worktree/" | sed "s|^${worktree}/||" | sort -u
}

# Drop anything committed on the branch that the agent did not author (generated/environmental drift).
# Restores each stray file to its base state and pushes a cleanup commit. No-op when we can't tell what
# the agent authored (empty set) so we never strip real work.
function sanitize_committed_branch() {
  local ticket_id=$1 worktree=$2 log_file=$3 branch=$4 base_ref=$5
  [ -d "$worktree" ] || return 0
  local edited; edited=$(agent_edited_files "$log_file" "$worktree")
  [ -z "$edited" ] && return 0
  ( cd "$worktree" && git fetch origin "$base_ref" >/dev/null 2>&1 )
  local strays=0 f
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    printf '%s\n' "$edited" | grep -qxF "$f" && continue      # agent authored it: keep
    if ( cd "$worktree" && git cat-file -e "origin/$base_ref:$f" 2>/dev/null ); then
      ( cd "$worktree" && git checkout "origin/$base_ref" -- "$f" 2>/dev/null )   # revert to base
    else
      ( cd "$worktree" && git rm -f --cached -- "$f" >/dev/null 2>&1; rm -f "$f" 2>/dev/null )  # agent-added, not authored
    fi
    echo "[$(date)] sanitize: dropped unrelated file from $branch: $f" >> "$log_file"
    strays=1
  done < <(cd "$worktree" && git diff --name-only "origin/$base_ref...HEAD" 2>/dev/null)
  [ "$strays" = 0 ] && return 0
  ( cd "$worktree" \
      && git add -A >/dev/null 2>&1 \
      && git commit -m "chore: drop files not part of [$ticket_id]" >/dev/null 2>&1 \
      && { git push --force-with-lease origin "$branch" >/dev/null 2>&1 || git push origin "$branch" >/dev/null 2>&1; } )
  echo "[$(date)] sanitize: pushed cleanup of unrelated files on $branch" >> "$DAEMON_LOG_FILE"
}

# resolve_base_ref <ticket_id> <log_file>
# Decides what a ticket's work should be based on, from its blockers' PR state.
# Prints exactly one line: "MAIN", "WAIT|<reason>", or "STACK|<parent_ticket>|<parent_branch>".
#   - no blockers / all blockers merged      -> MAIN   (build off origin/main)
#   - a blocker has no PR yet (not started)  -> WAIT   (recheck next poll)
#   - >1 blocker still open (can't stack 2)  -> WAIT
#   - exactly one blocker open with a branch -> STACK on that branch
function resolve_base_ref() {
  local ticket_id=$1 log_file=$2
  local blockers; blockers=$(node "$TRACKER_CLI" blockers "$ticket_id" 2>>"$log_file")
  [ -z "$blockers" ] && { echo "MAIN"; return; }
  command -v gh >/dev/null 2>&1 || { echo "MAIN"; return; }  # can't inspect PRs; don't block work

  local open_count=0 parent_ticket="" parent_branch=""
  local b prs merged branch expected
  for b in $blockers; do
    # Check the deterministic deputy branch first (exact, no search-index lag); fall back to
    # a text search so a collaborator's renamed branch is still found.
    expected=$(echo "$USER/$b" | tr '[:upper:]' '[:lower:]')
    prs=$(cd "$MAIN_PROJECT_DIR" && gh pr list --head "$expected" --state all --json headRefName,state 2>/dev/null)
    if [ -z "$prs" ] || [ "$prs" = "[]" ]; then
      prs=$(cd "$MAIN_PROJECT_DIR" && gh pr list --search "$b" --state all --json headRefName,state 2>/dev/null)
    fi
    [ -z "$prs" ] && prs='[]'
    merged=$(echo "$prs" | jq -r 'any(.[]; .state=="MERGED")' 2>/dev/null)
    [ "$merged" = "true" ] && continue                       # blocker already landed on main
    branch=$(echo "$prs" | jq -r 'map(select(.state=="OPEN"))[0].headRefName // empty' 2>/dev/null)
    if [ -z "$branch" ]; then echo "WAIT|$b not started yet"; return; fi
    open_count=$((open_count + 1)); parent_ticket="$b"; parent_branch="$branch"
  done

  if [ "$open_count" -eq 0 ]; then echo "MAIN"
  elif [ "$open_count" -eq 1 ]; then echo "STACK|$parent_ticket|$parent_branch"
  else echo "WAIT|waiting on $open_count unmerged dependencies"; fi
}

# recover_pr <ticket> <branch> <log_file> [stack_branch]
# Self-correct when the agent did the work (created the branch + commits) but couldn't push
# (e.g. a sandbox network blip). The daemon's git/gh run OUTSIDE the agent sandbox, so they're
# reliable. Pushes the branch and opens the draft PR. Returns 0 on success, 1 if nothing to do.
function recover_pr() {
  local ticket_id=$1 branch=$2 log_file=$3 stack_branch=$4 worktree=$5
  cd "$MAIN_PROJECT_DIR" || return 1
  # Two failure shapes to rescue (the daemon runs outside the agent sandbox, so its git is reliable):
  #   (a) agent committed to its branch but never pushed / opened the PR;
  #   (b) agent wrote code but did NO git at all — uncommitted/untracked work on a detached HEAD in its
  #       worktree. Commit it here so the work ships instead of being marked FAILED with the code left behind.
  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    if [ -n "$worktree" ] && [ -d "$worktree" ] && [ -n "$(git -C "$worktree" status --porcelain 2>/dev/null)" ]; then
      echo "[$(date)] recover: agent left uncommitted work and no branch; committing it from the daemon" >> "$log_file"
      local rtitle; rtitle=$(node "$TRACKER_CLI" title "$ticket_id" 2>/dev/null); [ -z "$rtitle" ] && rtitle="$ticket_id"
      git -C "$worktree" checkout -b "$branch" >> "$log_file" 2>&1 || { echo "[$(date)] recover: branch create failed" >> "$log_file"; return 1; }
      # Stage only what the agent authored (not setup/test-generated drift); fall back to everything if unknown.
      local edited; edited=$(agent_edited_files "$log_file" "$worktree")
      if [ -n "$edited" ]; then
        while IFS= read -r f; do [ -n "$f" ] && git -C "$worktree" add -- "$f" >> "$log_file" 2>&1; done <<< "$edited"
      else
        git -C "$worktree" add -A >> "$log_file" 2>&1
      fi
      git -C "$worktree" commit -m "feat: ${rtitle} [${ticket_id}]" >> "$log_file" 2>&1 \
        || { echo "[$(date)] recover: could not commit worktree changes" >> "$log_file"; return 1; }
    else
      echo "[$(date)] recover: no local branch $branch and nothing uncommitted to rescue" >> "$log_file"; return 1
    fi
  fi
  echo "[$(date)] recover: pushing $branch + opening PR from the daemon (agent couldn't)" >> "$log_file"
  git push -u origin "$branch" >> "$log_file" 2>&1 || { echo "[$(date)] recover: push failed" >> "$log_file"; return 1; }
  local title; title=$(git log -1 --format=%s "$branch" 2>/dev/null); [ -z "$title" ] && title="$ticket_id"
  local pr_ref; pr_ref=$(node "$TRACKER_CLI" ref "$ticket_id" 2>/dev/null)
  local url
  if [ -n "$stack_branch" ]; then
    url=$(gh pr create --draft --label "$PR_LABEL" --base "$stack_branch" --head "$branch" --title "$title" --body "${pr_ref:-Automated by Deputy.}" 2>>"$log_file")
  else
    url=$(gh pr create --draft --label "$PR_LABEL" --head "$branch" --title "$title" --body "${pr_ref:-Automated by Deputy.}" 2>>"$log_file")
  fi
  [ -z "$url" ] && url=$(gh pr view "$branch" --json url --jq .url 2>/dev/null)
  [ -z "$url" ] && { echo "[$(date)] recover: PR create failed" >> "$log_file"; return 1; }
  echo "[$(date)] recover: opened $url" >> "$log_file"   # logged so PR-url detection + stack-file see it
  return 0
}

# Evaluator-Optimizer loop (Anthropic, "Building Effective Agents"): a SEPARATE skeptical pass
# (verify.mjs) judges the work against the ticket's acceptance criteria, grounded in the real diff —
# not the builder's say-so. If gaps remain, resume the builder with those exact gaps and re-check,
# bounded by DEPUTY_VERIFY_MAX. Catches the two failure modes we hit: the builder quitting early
# (gaps fed back) and skipping git (no-PR is a gap). recover_pr remains the floor if it never converges.
function verify_and_optimize() {
  local ticket_id=$1 worktree=$2 log_file=$3 input_file=$4 ask_file=$5 session_file=$6
  [ "${DEPUTY_VERIFY:-true}" = "true" ] || return 0
  [ -f "$ask_file" ] && return 0   # parked on a question; don't verify
  local vmax="${DEPUTY_VERIFY_MAX:-2}" vi=0
  while [ "$vi" -lt "$vmax" ]; do
    local verdict vrc gaps
    verdict=$(env -u CLAUDECODE DEPUTY_SDK_DIR="$AUTOMATION_BASE_DIR/node_modules" node "$VERIFY_CLI" "$ticket_id" "$worktree" 2>>"$DAEMON_LOG_FILE")
    vrc=$?
    echo "[$(date)] verify #$((vi+1))/$vmax (rc=$vrc): $verdict" >> "$log_file"
    [ "$vrc" -eq 0 ] && return 0                         # evaluator says done
    gaps=$(printf '%s' "$verdict" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log((JSON.parse(s).gaps||[]).map(g=>"- "+g).join("\n"))}catch{}})' 2>/dev/null)
    [ -z "$gaps" ] && return 0                           # no actionable gaps; let the normal flow arbitrate
    echo "[$(date)] verify: resuming builder to close gaps (#$((vi+1))/$vmax)" >> "$log_file"
    run_agent "$worktree" "A skeptical review found this work is NOT complete. Address ALL of these gaps, then commit and open or update the draft PR:
${gaps}

Do not stop until every gap is resolved and the PR is up." "$log_file" "$input_file" "$ask_file" "$session_file" "$(cat "$session_file" 2>/dev/null)"
    [ -f "$ask_file" ] && return 0                       # builder parked mid-fix
    vi=$((vi + 1))
  done
  return 0
}

# Prints the head branch of this ticket's open PR (any name), or empty. Name-agnostic, so it
# finds a manually-created branch Claude took over, not just Deputy's own naming.
function ticket_pr_branch() {
  local ticket_id=$1
  command -v gh >/dev/null 2>&1 || return 0
  cd "$MAIN_PROJECT_DIR" && gh pr list --state open --search "$ticket_id" --json headRefName --jq '.[0].headRefName // empty' 2>/dev/null
}

function process_ticket() {
  local ticket_id=$1
  local log_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.log"
  local ticket_worktree="${AUTOMATION_BASE_DIR}_${ticket_id}"
  local lock_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.lock"
  local input_file="${RUNTIME_DIR}/deputy-input-${ticket_id}.jsonl"   # live chat channel for this agent
  local meta_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.meta"      # which deputy (repo) this case belongs to
  local ask_file="${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt"
  local session_file; session_file=$(session_file_for "$ticket_id")  # durable: survives reboot
  local blocked_meta="${RUNTIME_DIR}/deputy-blocked-${ticket_id}.meta"
  local stack_file; stack_file=$(stack_record "$ticket_id"); mkdir -p "$STACKS_DIR"

  # --- Dependency gate (stacked PRs) -------------------------------------------
  # Decide the base BEFORE marking started, so a blocked ticket keeps its label and
  # gets re-checked on the next poll. We don't hold a lock while blocked.
  echo "[$(date)] Resolving dependencies for $ticket_id..." > "$log_file"
  local base; base=$(resolve_base_ref "$ticket_id" "$log_file")
  local base_kind="${base%%|*}" stack_branch="" stack_parent=""
  if [ "$base_kind" = "WAIT" ]; then
    local reason="${base#WAIT|}"
    echo "$PROJECT_NAME" > "$blocked_meta"
    echo "$reason" > "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.txt"
    local burl; burl=$(node "$TRACKER_CLI" url "$ticket_id" 2>/dev/null)
    [ -n "$burl" ] && echo "[$(date)] ITEM_URL: $burl" >> "$log_file"
    echo "[$(date)] BLOCKED: $ticket_id ($reason)" >> "$DAEMON_LOG_FILE"
    echo "[$(date)] Blocked: $reason. Will re-check next patrol." >> "$log_file"
    rm -f "$lock_file"
    return 0
  fi
  rm -f "$blocked_meta" "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.txt"
  if [ "$base_kind" = "STACK" ]; then
    stack_parent=$(echo "$base" | cut -d'|' -f2)
    stack_branch=$(echo "$base" | cut -d'|' -f3)
  fi

  : > "$input_file"
  echo "$PROJECT_NAME" > "$meta_file"
  rm -f "$ask_file" "$session_file" "${RUNTIME_DIR}/deputy-paused-${ticket_id}.meta" \
        "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt"  # clear a prior failure on (re)start
  [ -f "${RUNTIME_DIR}/deputy-auto-${ticket_id}" ] && export DEPUTY_FULL_AUTO=1  # full-auto: never park to ask
  # The spawner records our real PID in the lock (for stop-ticket); we clear it on exit.
  trap "rm -f '$lock_file' '$input_file' '$meta_file'" EXIT

  echo "[$(date)] Starting work on $ticket_id" >> "$log_file"

  # Mark started immediately so the next poll does not re-pick it — EXCEPT a multi-repo ticket,
  # whose label must stay so the other repos' Deputies can claim their slice too. Those cases are
  # de-duped by the routed-file (":done" on success) instead of by label removal.
  local route_state; route_state=$(grep "^${ticket_id}:" "$ROUTED_FILE" 2>/dev/null | tail -1 | cut -d: -f2)
  if [ "$route_state" = "multi" ]; then
    echo "[$(date)] Multi-repo ticket; leaving the label for other deputies." >> "$log_file"
  else
    echo "[$(date)] Marking $ticket_id started..." >> "$log_file"
    node "$TRACKER_CLI" start "$ticket_id" >> "$log_file" 2>&1 \
      || echo "[$(date)] WARN: markStarted failed for $ticket_id" >> "$log_file"
  fi

  if ! cd "$MAIN_PROJECT_DIR"; then
    echo "[$(date)] FAILED: $ticket_id (cd failed)" >> "$DAEMON_LOG_FILE"
    rm -f "$lock_file"; return 1
  fi

  # Resolve the ticket's branch: its open PR's head (any name), else the deterministic name.
  local branch_name; branch_name=$(ticket_pr_branch "$ticket_id")
  [ -z "$branch_name" ] && branch_name=$(echo "$USER/$ticket_id" | tr '[:upper:]' '[:lower:]')

  # One rule, no "collaboration" mode: if the branch is already checked out in a worktree
  # (yours, or one Deputy kept) use that worktree — git only allows a branch in one worktree.
  # Else reuse the branch's commits if it exists, else start fresh off main/parent.
  local reusing=0
  local existing_wt; existing_wt=$(worktree_for_branch "$branch_name")
  if [ -n "$existing_wt" ] && [ -d "$existing_wt" ]; then
    ticket_worktree="$existing_wt"; reusing=1
    export DEPUTY_SDK_DIR="$AUTOMATION_BASE_DIR/node_modules"
    echo "[$(date)] Reusing worktree $existing_wt (branch $branch_name)" >> "$log_file"
  else
    git fetch origin "$branch_name" >> "$log_file" 2>&1 || true
    local branch_exists=0
    { git show-ref --verify --quiet "refs/remotes/origin/$branch_name" || git show-ref --verify --quiet "refs/heads/$branch_name"; } && branch_exists=1
    if [ -d "$ticket_worktree" ]; then
      git worktree remove --force "$ticket_worktree" 2>/dev/null || true
      rm -rf "$ticket_worktree" 2>/dev/null || true
    fi
    git worktree prune 2>/dev/null || true
    if [ "$branch_exists" -eq 1 ]; then
      reusing=1
      echo "[$(date)] Reusing branch $branch_name for $ticket_id (continuing, not restarting)" >> "$log_file"
      if ! git worktree add "$ticket_worktree" "$branch_name" >> "$log_file" 2>&1; then
        echo "[$(date)] FAILED: $ticket_id (checkout of existing $branch_name failed)" >> "$DAEMON_LOG_FILE"
        rm -f "$lock_file"; return 1
      fi
    else
      local base_commit="origin/main"
      if [ -n "$stack_branch" ]; then
        base_commit="origin/$stack_branch"
        git fetch origin "$stack_branch" >> "$log_file" 2>&1 || true
        echo "[$(date)] Stacking $ticket_id on $stack_branch" >> "$log_file"
      fi
      echo "[$(date)] Creating worktree for $ticket_id (base: $base_commit)..." >> "$log_file"
      if ! git worktree add --detach "$ticket_worktree" "$base_commit" >> "$log_file" 2>&1; then
        echo "[$(date)] FAILED: $ticket_id (worktree creation failed)" >> "$DAEMON_LOG_FILE"
        rm -f "$lock_file"; return 1
      fi
    fi
    setup_worktree "$ticket_worktree" "$log_file"
  fi

  local item_url;   item_url=$(node "$TRACKER_CLI" url "$ticket_id" 2>/dev/null)
  local item_title; item_title=$(node "$TRACKER_CLI" title "$ticket_id" 2>/dev/null)
  local pr_ref;     pr_ref=$(node "$TRACKER_CLI" ref "$ticket_id" 2>/dev/null)
  [ -n "$item_url" ] && echo "[$(date)] ITEM_URL: $item_url" >> "$log_file"
  [ -n "$item_title" ] && echo "[$(date)] ITEM_TITLE: $item_title" >> "$log_file"
  echo "[$(date)] WORKTREE: $ticket_worktree" >> "$log_file"

  # When stacked, the PR must target the parent's branch (not main) so its diff is just our changes.
  local pr_base_flag="" stack_note=""
  if [ -n "$stack_branch" ]; then
    pr_base_flag=" --base \"$stack_branch\""
    stack_note="
**STACKED PR:** This ticket depends on a sibling whose work lives on branch \`$stack_branch\`. You are branched off it, so your diff should be ONLY your own changes on top. When you open the PR you MUST pass \`--base $stack_branch\` (included below) so GitHub stacks it correctly."
  fi

  local prompt
  if [ "$reusing" -eq 1 ]; then
  prompt="Continue work item $ticket_id — this branch already has work on it.

**IMPORTANT:** You are in a worktree at $ticket_worktree, already checked out on branch \`$branch_name\`. DO NOT start over, DO NOT recreate the branch, DO NOT cd elsewhere.
${stack_note}
${item_url:+**Work item:** $item_url}

**Tasks:**
1. Read the work item with \`mcp__tracker__get_item\` (itemId: $ticket_id).
2. See what's already here: \`git log --oneline origin/main..HEAD\` and \`git status\`. Build on it; do NOT redo completed work, and include any uncommitted changes that clearly belong with this work.
3. Implement anything still missing to satisfy the item, following the repo's conventions (READ \`./CLAUDE.md\`, \`./.claude/rules/\`, \`./CONTRIBUTING.md\` if present).
4. Run $TEST_INSTRUCTIONS.
5. Commit any new changes and push to origin/$branch_name.
6. If there is NOT already an open PR for this branch, create a draft PR, labelled so deputy can watch its CI:
   - \`gh pr create --draft --label \"$PR_LABEL\"${pr_base_flag} --title \"<type>: <summary> [$ticket_id]\" ...\`
   - For the body: if the repo has a PR template (\`.github/pull_request_template.md\` or \`.github/PULL_REQUEST_TEMPLATE/\`), READ it and fill out its sections verbatim; otherwise use a short Summary + Test plan. Keep it concise.${pr_ref:+
   - The body MUST include the work-item link: \"$pr_ref\"}
   (If a PR already exists, your push already updated it — do NOT open a second one.)
7. Mark the work item done with \`mcp__tracker__finish\` (itemId: $ticket_id)

You may receive follow-up messages while you work (via the dashboard). Work autonomously and
make reasonable, reversible decisions; only call \`mcp__deputy__ask_user\` if you genuinely
cannot proceed. When done, report the PR URL."
  else
  prompt="Implement work item $ticket_id

**IMPORTANT:** You are in an isolated git worktree at $ticket_worktree on a detached HEAD. DO NOT cd elsewhere. All commands run in the current directory (pwd).
${stack_note}
${item_url:+**Work item:** $item_url}

**CRITICAL CONSTRAINTS:**
- You are in an isolated worktree at: $ticket_worktree
- DO NOT use the Agent/Task tool - work directly (the tracker MCP tools mcp__tracker__* are available here)
- DO NOT cd to any other directory - stay in current directory (pwd)
- You are on a detached HEAD - do NOT checkout any branch until the end
- ALL file operations must be in the current directory

**Tasks:**
1. Read the work item with \`mcp__tracker__get_item\` (itemId: $ticket_id) for the title, description, and comments. Use the title for the commit/PR title.
2. You are already on a detached HEAD from main - do NOT checkout any branch yet
3. READ and follow the repo's conventions: \`./CLAUDE.md\`, \`./.claude/rules/\` (if present), and \`./CONTRIBUTING.md\` (if present)
4. Implement the requirements from the item
5. Run $TEST_INSTRUCTIONS.
6. Commit with an appropriate conventional commit type (feat/fix/refactor/etc): <type>: <summary> [$ticket_id]
7. Create branch from current commit: git branch $branch_name
8. Push branch to origin: git push origin $branch_name
9. Create a draft PR with gh CLI, labelled so deputy can watch its CI:
   - \`gh pr create --draft --label \"$PR_LABEL\"${pr_base_flag} --title \"<type>: <summary> [$ticket_id]\" ...\`
   - For the body: if the repo has a PR template (\`.github/pull_request_template.md\` or \`.github/PULL_REQUEST_TEMPLATE/\`), READ it and fill out its sections verbatim; otherwise use a short Summary + Test plan. Keep it concise.${pr_ref:+
   - The body MUST include the work-item link: \"$pr_ref\"}
10. Mark the work item done with \`mcp__tracker__finish\` (itemId: $ticket_id)

You may receive follow-up messages while you work (via the dashboard) — treat each as
additional instructions in this same session and keep going.

**Default to working autonomously** and make reasonable, reversible decisions yourself. Only
call \`mcp__deputy__ask_user\` when you genuinely cannot proceed (a required product or design
decision, a hard-to-reverse choice, or missing access or information): ask one specific
question and STOP, do not guess or open a PR, and you will be resumed with the answer.

Work autonomously. When done, report the PR URL."
  fi

  # Durable journal so the case can be resumed after a daemon/computer restart.
  write_journal "$ticket_id" working "$PROJECT_NAME" "$ticket_worktree" "$branch_name" "$base_kind" "$stack_branch" "$stack_parent"

  local timeout_mins=$((CLAUDE_TIMEOUT_SECONDS / 60))
  echo "[$(date)] Starting agent (max ${timeout_mins} min, live chat via dashboard)..." >> "$log_file"
  run_agent "$ticket_worktree" "$prompt" "$log_file" "$input_file" "$ask_file" "$session_file"
  local exit_code=$?

  # Parked on a question: keep the worktree + saved session, surface it, and wait.
  if [ -f "$ask_file" ]; then
    echo "[$(date)] NEEDS-INPUT: $ticket_id" >> "$DAEMON_LOG_FILE"
    echo "$PROJECT_NAME" > "${RUNTIME_DIR}/deputy-paused-${ticket_id}.meta"
    set_journal_status "$ticket_id" parked
    echo "[$(date)] Paused waiting for your answer (reply in the dashboard)." >> "$log_file"
    trap - EXIT; rm -f "$lock_file" "$input_file" "$meta_file"
    return 0
  fi

  # Evaluator-Optimizer: a separate skeptical pass checks the work against the ticket's acceptance
  # criteria and resumes the builder to close any gaps, before we judge success below.
  verify_and_optimize "$ticket_id" "$ticket_worktree" "$log_file" "$input_file" "$ask_file" "$session_file"

  # A run only "succeeded" if it actually produced a PR. No PR = failure, even on a clean exit —
  # we must NEVER call a run success and let the case vanish silently.
  local made_pr=0
  grep -qiE 'github\.com/[^ ]+/pull/[0-9]+' "$log_file" && made_pr=1
  # A continued run may just push to an already-open PR (no new PR url in the log).
  if [ "$made_pr" -eq 0 ]; then
    local hp; hp=$(cd "$MAIN_PROJECT_DIR" && gh pr list --head "$branch_name" --state open --json number --jq 'length' 2>/dev/null)
    [ "${hp:-0}" != "0" ] && made_pr=1
  fi

  # Self-correct: if the agent finished the code but never got a PR up, the daemon pushes the
  # branch + opens the PR itself (it runs outside the agent's sandbox, so the push is reliable).
  if [ "$made_pr" -eq 0 ]; then
    if recover_pr "$ticket_id" "$branch_name" "$log_file" "$stack_branch" "$ticket_worktree"; then made_pr=1; fi
  fi

  local failed=0 reason=""
  if [ $exit_code -eq 124 ] && [ "$made_pr" -eq 0 ]; then failed=1; reason="timed out after ${timeout_mins} min"
  elif [ $exit_code -ne 0 ] && [ "$made_pr" -eq 0 ]; then failed=1; reason="agent exited with code $exit_code and left no PR to recover"
  elif [ "$made_pr" -eq 0 ]; then failed=1; reason="finished with no PR and no branch to recover"
  fi

  if [ "$failed" -eq 1 ]; then
    echo "[$(date)] FAILED: $ticket_id ($reason)" >> "$DAEMON_LOG_FILE"
    echo "$PROJECT_NAME" > "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta"
    set_journal_status "$ticket_id" failed
    { echo "$reason"; grep -iE 'fatal:|^\[ERROR\]|CONNECT tunnel|Stream closed|rejected|permission denied|error_max_turns|not allowed' "$log_file" | tail -3; } > "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt"
    echo "[$(date)] Marked FAILED ($reason). Worktree kept at $ticket_worktree so no work is lost; restart the case to retry." >> "$log_file"
    trap - EXIT; rm -f "$lock_file" "$input_file" "$meta_file"   # keep the worktree
    return 0
  fi

  # Keep the PR to only what the agent authored — strip generated/environmental drift (structure.sql,
  # lockfiles, etc.) that setup/tests regenerated and the agent swept in.
  sanitize_committed_branch "$ticket_id" "$ticket_worktree" "$log_file" "$branch_name" "${stack_branch:-main}"

  echo "[$(date)] SUCCESS: $ticket_id" >> "$DAEMON_LOG_FILE"

  # Multi-repo ticket kept its label (so sibling Deputies could claim); mark it done here so this
  # Deputy won't re-pick it on the next poll.
  if [ "$route_state" = "multi" ]; then
    grep -v "^${ticket_id}:" "$ROUTED_FILE" > "${ROUTED_FILE}.tmp" 2>/dev/null; mv -f "${ROUTED_FILE}.tmp" "$ROUTED_FILE" 2>/dev/null
    echo "${ticket_id}:done" >> "$ROUTED_FILE"
  fi

  # Record a stacked PR so maintain_stacks keeps it rebased as the parent moves/merges.
  if [ -n "$stack_branch" ] && grep -qiE 'github\.com/[^ ]+/pull/[0-9]+' "$log_file"; then
    local psha; psha=$(cd "$MAIN_PROJECT_DIR" && git rev-parse "origin/$stack_branch" 2>/dev/null)
    jq -nc --arg p "$PROJECT_NAME" --arg pt "$stack_parent" --arg pb "$stack_branch" --arg cb "$branch_name" --arg s "$psha" \
      '{project:$p, parent_ticket:$pt, parent_branch:$pb, child_branch:$cb, last_parent_sha:$s}' > "$stack_file"
    echo "[$(date)] Stack recorded: $ticket_id ($branch_name) on $stack_branch @ ${psha:0:8}" >> "$DAEMON_LOG_FILE"
  fi

  # Keep the worktree so you can cd in and test the PR locally; it's pruned when the PR
  # merges or closes (see prune_merged_worktrees).
  echo "[$(date)] Done. Worktree kept for local testing at $ticket_worktree." >> "$log_file"
  prepare_worktree_for_testing "$ticket_worktree" "$log_file"
  # Keep the journal + SDK session (status=done) so a follow-up chat resumes this agent warm
  # instead of starting cold; both are cleared when the PR merges/closes (prune_merged_worktrees).
  set_journal_status "$ticket_id" done
  rm -f "$lock_file"
}

# resume_ticket <ticket_id> <reply>
# Answers a parked case: resumes its saved SDK session in the same worktree.
function resume_ticket() {
  local ticket_id=$1 reply=$2
  local log_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.log"
  local lock_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.lock"
  local input_file="${RUNTIME_DIR}/deputy-input-${ticket_id}.jsonl"
  local meta_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.meta"
  local ask_file="${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt"
  local session_file; session_file=$(session_file_for "$ticket_id")
  local paused_meta="${RUNTIME_DIR}/deputy-paused-${ticket_id}.meta"
  local jf; jf=$(journal_file "$ticket_id")
  local ticket_worktree; ticket_worktree=$(jq -r '.worktree // empty' "$jf" 2>/dev/null)
  [ -z "$ticket_worktree" ] && ticket_worktree="${AUTOMATION_BASE_DIR}_${ticket_id}"

  local session; session=$(cat "$session_file" 2>/dev/null)
  if [ -z "$session" ] || [ ! -d "$ticket_worktree" ]; then
    echo "[$(date)] Cannot resume $ticket_id (missing session or worktree)" >> "$DAEMON_LOG_FILE"
    return 1
  fi

  : > "$input_file"
  echo "$PROJECT_NAME" > "$meta_file"
  rm -f "$ask_file" "$paused_meta"
  [ -f "${RUNTIME_DIR}/deputy-auto-${ticket_id}" ] && export DEPUTY_FULL_AUTO=1
  trap "rm -f '$lock_file' '$input_file' '$meta_file'" EXIT

  set_journal_status "$ticket_id" working
  local prompt
  if [ "$reply" = "__continue__" ]; then
    echo "[$(date)] Resuming interrupted $ticket_id (continue where it left off)" >> "$log_file"
    echo "⏳ Reconnecting to the agent..." >> "$log_file"
    prompt="You were interrupted (the daemon or machine restarted). Resume exactly where you left off and finish the work: first check the current state (git status, and whether a PR already exists for this branch), then implement anything still missing, run $TEST_INSTRUCTIONS, commit, push, and open or update the draft PR. Do NOT redo work that is already committed."
  else
    echo "[$(date)] Resuming $ticket_id with your answer" >> "$log_file"
    echo "[YOU] $reply" >> "$log_file"
    echo "⏳ Reconnecting to the agent..." >> "$log_file"
    prompt="The user sent you a message mid-run — this is them steering you, so address it FIRST,
before anything else:

$reply

- If it's a question, answer it directly and concisely.
- If it's a redirection or a change they want, acknowledge it and apply it.
- If it's a quick check-in, reply briefly.
Respond to what they actually said before taking any other action. Only continue the prior work
AFTER you've responded, and only if it still makes sense given their message. If you're unsure
what they want, ask them rather than guessing or charging ahead. Do NOT redo work that is already
committed."
  fi

  run_agent "$ticket_worktree" "$prompt" "$log_file" "$input_file" "$ask_file" "$session_file" "$session"
  local exit_code=$?

  if [ -f "$ask_file" ]; then
    echo "[$(date)] NEEDS-INPUT: $ticket_id" >> "$DAEMON_LOG_FILE"
    echo "$PROJECT_NAME" > "$paused_meta"
    set_journal_status "$ticket_id" parked
    echo "[$(date)] Paused waiting for your answer (reply in the dashboard)." >> "$log_file"
    trap - EXIT; rm -f "$lock_file" "$input_file" "$meta_file"
    return 0
  fi

  # Self-correct / never-vanish, same as a fresh run: recover the PR if the agent couldn't,
  # else keep the worktree and mark it failed (visible) instead of silently deleting it.
  local made_pr=0
  grep -qiE 'github\.com/[^ ]+/pull/[0-9]+' "$log_file" && made_pr=1
  local jbranch jstack jwt
  jbranch=$(jq -r '.branch // empty' "$jf" 2>/dev/null)
  jstack=$(jq -r '.stack_branch // empty' "$jf" 2>/dev/null)
  jwt=$(jq -r '.worktree // empty' "$jf" 2>/dev/null)
  if [ "$made_pr" -eq 0 ] && [ -n "$jbranch" ]; then
    recover_pr "$ticket_id" "$jbranch" "$log_file" "$jstack" "$jwt" && made_pr=1
  fi

  if [ $exit_code -ne 0 ] && [ "$made_pr" -eq 0 ]; then
    echo "[$(date)] FAILED: $ticket_id (resumed, exit $exit_code)" >> "$DAEMON_LOG_FILE"
    echo "$PROJECT_NAME" > "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta"
    set_journal_status "$ticket_id" failed
    { echo "resumed run failed (exit $exit_code)"; grep -iE 'fatal:|^\[ERROR\]|CONNECT tunnel|Stream closed|rejected|permission denied|error_max_turns' "$log_file" | tail -3; } > "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt"
    trap - EXIT; rm -f "$lock_file" "$input_file" "$meta_file"   # keep the worktree
    return 0
  fi

  echo "[$(date)] SUCCESS: $ticket_id (resumed). Worktree kept for local testing at $ticket_worktree." >> "$DAEMON_LOG_FILE"
  prepare_worktree_for_testing "$ticket_worktree" "$log_file"
  set_journal_status "$ticket_id" done   # keep session warm for follow-up chat; cleared on PR merge/close
  trap - EXIT; rm -f "$lock_file" "$input_file" "$meta_file"
}

# resume_or_restart <ticket> — bring a case back: resume its saved SDK session if the
# worktree + session survive; else finish the push/PR if the branch has work; else re-run
# from scratch. Used by reconcile-on-start and the dashboard ▶ re-run button.
function resume_or_restart() {
  local ticket_id=$1
  local jf; jf=$(journal_file "$ticket_id")
  local log_file="${RUNTIME_DIR}/deputy-item-${ticket_id}.log"
  rm -f "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt" "${RUNTIME_DIR}/deputy-stopped-${ticket_id}.meta"
  local session wt branch stack
  session=$(cat "$(session_file_for "$ticket_id")" 2>/dev/null)
  wt=$(jq -r '.worktree // empty' "$jf" 2>/dev/null)
  branch=$(jq -r '.branch // empty' "$jf" 2>/dev/null)
  stack=$(jq -r '.stack_branch // empty' "$jf" 2>/dev/null)

  if [ -n "$session" ] && [ -n "$wt" ] && [ -d "$wt" ]; then
    resume_ticket "$ticket_id" "__continue__"; return
  fi
  echo "$PROJECT_NAME" > "${RUNTIME_DIR}/deputy-item-${ticket_id}.meta"
  if [ -n "$branch" ] && recover_pr "$ticket_id" "$branch" "$log_file" "$stack" "$wt"; then
    echo "[$(date)] Re-run: finished $ticket_id's PR without a full re-run" >> "$DAEMON_LOG_FILE"
    clear_journal "$ticket_id"; rm -f "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" "${RUNTIME_DIR}/deputy-item-${ticket_id}.meta"; return
  fi
  echo "[$(date)] Re-run: starting $ticket_id from scratch" >> "$DAEMON_LOG_FILE"
  clear_journal "$ticket_id"; rm -f "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock"
  process_ticket "$ticket_id"
}

# reconcile_cases — on daemon start, reconnect to cases interrupted by a kill/restart/reboot.
# The durable journal (in <repo>_deputy/cases) is the source of truth; /tmp is ephemeral.
function reconcile_cases() {
  [ -d "$CASES_DIR" ] || return 0
  local f ticket proj status lock
  for f in "$CASES_DIR"/*.json; do
    [ -f "$f" ] || continue
    ticket=$(jq -r '.ticket // empty' "$f" 2>/dev/null)
    proj=$(jq -r '.project // empty' "$f" 2>/dev/null)
    status=$(jq -r '.status // empty' "$f" 2>/dev/null)
    [ -z "$ticket" ] && continue
    [ "$proj" = "$PROJECT_NAME" ] || continue
    lock="${RUNTIME_DIR}/deputy-item-${ticket}.lock"
    if [ -f "$lock" ] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then continue; fi  # still alive
    rm -f "$lock"   # stale lock from a killed agent
    case "$status" in
      working)  # interrupted mid-run → bring it back
        echo "[$(date)] Reconcile: $ticket was interrupted; resuming" >> "$DAEMON_LOG_FILE"
        resume_or_restart "$ticket" & echo $! > "$lock" ;;
      failed)   # rehydrate the /tmp marker (wiped on reboot) so it stays visible
        echo "$proj" > "${RUNTIME_DIR}/deputy-failed-${ticket}.meta"
        [ -f "${RUNTIME_DIR}/deputy-failed-${ticket}.txt" ] || echo "the run failed before the last restart" > "${RUNTIME_DIR}/deputy-failed-${ticket}.txt" ;;
      stopped)
        echo "$proj" > "${RUNTIME_DIR}/deputy-stopped-${ticket}.meta" ;;
    esac
  done
}

# stop-ticket: halt the agent but KEEP everything needed to bring it back (worktree, branch,
# saved session, journal). The case becomes a "stopped" card with a ▶ re-run button.
function stop_ticket() {
  local ticket_id=$1
  [ -z "$ticket_id" ] && { echo "Usage: deputy stop-ticket <TICKET>"; exit 1; }
  local killed=0 lf pid

  for lf in "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" ${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-*.lock; do
    [ -f "$lf" ] || continue
    pid=$(cat "$lf" 2>/dev/null)
    [ -n "$pid" ] && { kill_tree "$pid"; killed=1; }
    rm -f "$lf" "${lf%.lock}.meta"
  done

  # Clear only the transient in-flight markers; keep the durable journal + session + worktree.
  rm -f "${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt" "${RUNTIME_DIR}/deputy-paused-${ticket_id}.meta" \
        "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.txt" \
        "$(stack_record "$ticket_id")" "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt"

  if [ -f "$(journal_file "$ticket_id")" ]; then
    set_journal_status "$ticket_id" stopped
    echo "$PROJECT_NAME" > "${RUNTIME_DIR}/deputy-stopped-${ticket_id}.meta"   # stays on the board as a stopped card
    killed=1
  fi
  [ $killed -eq 1 ] && echo "Stopped $ticket_id (halted; kept so you can ▶ re-run it)." || echo "$ticket_id does not appear to be active."
}

# forget-ticket: the real delete — halt, drop the worktree, and clear all state.
function forget_ticket() {
  local ticket_id=$1
  [ -z "$ticket_id" ] && { echo "Usage: deputy forget-ticket <TICKET>"; exit 1; }
  local lf pid
  for lf in "${RUNTIME_DIR}/deputy-item-${ticket_id}.lock" ${RUNTIME_DIR}/deputy-item-${ticket_id}-cont-*.lock; do
    [ -f "$lf" ] || continue; pid=$(cat "$lf" 2>/dev/null); [ -n "$pid" ] && kill_tree "$pid"; rm -f "$lf" "${lf%.lock}.meta"
  done
  rm -f "${RUNTIME_DIR}/deputy-ask-${ticket_id}.txt" "${RUNTIME_DIR}/deputy-paused-${ticket_id}.meta" \
        "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-blocked-${ticket_id}.txt" \
        "$(stack_record "$ticket_id")" "${RUNTIME_DIR}/deputy-failed-${ticket_id}.meta" \
        "${RUNTIME_DIR}/deputy-failed-${ticket_id}.txt" "${RUNTIME_DIR}/deputy-stopped-${ticket_id}.meta" "${RUNTIME_DIR}/deputy-item-${ticket_id}.meta"
  clear_journal "$ticket_id"
  local wt="${AUTOMATION_BASE_DIR}_${ticket_id}"
  [ -d "$wt" ] && { cd "$MAIN_PROJECT_DIR" && git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; git worktree prune 2>/dev/null || true; }
  echo "Forgot $ticket_id (removed its worktree + state)."
}

# Auto-start at login so a reboot brings Deputy (and its interrupted cases) back by itself.
# launchd supervises the foreground loop; on login it starts, and reconcile_cases resumes work.
function autostart_install() {
  local dir="$HOME/Library/LaunchAgents" plist
  plist="$dir/com.deputy.${PROJECT_NAME}.plist"
  mkdir -p "$dir"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.deputy.${PROJECT_NAME}</string>
  <key>ProgramArguments</key><array><string>${DAEMON_BIN}</string><string>foreground</string></array>
  <key>WorkingDirectory</key><string>${MAIN_PROJECT_DIR}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${DAEMON_LOG_FILE}</string>
  <key>StandardErrorPath</key><string>${DAEMON_LOG_FILE}</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict></plist>
PLIST
  launchctl unload "$plist" 2>/dev/null || true
  launchctl load "$plist" 2>/dev/null && echo "Autostart installed: $plist" || echo "Wrote $plist (run: launchctl load \"$plist\")"
}
function autostart_uninstall() {
  local plist="$HOME/Library/LaunchAgents/com.deputy.${PROJECT_NAME}.plist"
  launchctl unload "$plist" 2>/dev/null || true
  rm -f "$plist"
  echo "Autostart removed for $PROJECT_NAME"
}
# Foreground supervised loop (used by launchd): set up, then run the loop without forking so
# the supervisor can keep it alive and restart it on crash/reboot.
function run_foreground() {
  if [ -f "$DAEMON_PID_FILE" ] && ps -p "$(cat "$DAEMON_PID_FILE")" >/dev/null 2>&1; then
    echo "Daemon already running (PID: $(cat "$DAEMON_PID_FILE"))"; exit 0
  fi
  preflight_tracker; ensure_deps
  echo "$MAIN_PROJECT_DIR" > "$DAEMON_META_FILE"
  echo $$ > "$DAEMON_PID_FILE"
  trap 'rm -f "$DAEMON_PID_FILE" "$DAEMON_META_FILE"' EXIT
  watch_and_process
}

# Preflight: verify prerequisites + config + credentials and say exactly what's missing.
function doctor() {
  local bad=0
  echo "Deputy doctor"
  command -v node >/dev/null 2>&1 && echo "  ✓ node ($(node -v))" || { echo "  ✗ node — install Node ≥18"; bad=1; }
  local nv; nv=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)
  { [ -n "$nv" ] && [ "$nv" -lt 18 ]; } && { echo "  ✗ node must be ≥18 (have $(node -v))"; bad=1; }
  command -v git >/dev/null 2>&1 && echo "  ✓ git" || { echo "  ✗ git — not installed"; bad=1; }
  command -v jq  >/dev/null 2>&1 && echo "  ✓ jq"  || { echo "  ✗ jq — e.g. brew install jq"; bad=1; }
  if command -v gh >/dev/null 2>&1; then
    gh auth status >/dev/null 2>&1 && echo "  ✓ gh (authenticated)" || { echo "  ✗ gh not authenticated — run: gh auth login"; bad=1; }
  else echo "  ✗ gh — install the GitHub CLI"; bad=1; fi
  [ -f "$PROJECT_ROOT/.env" ] && echo "  ✓ .env present" || { echo "  ✗ .env missing — run: npm run setup"; bad=1; }
  local tracker="${DEPUTY_TRACKER:-jira}"
  req() { [ -n "${!1}" ] && echo "  ✓ $1" || { echo "  ✗ $1 missing"; bad=1; }; }
  req DEPUTY_GITHUB_TOKEN
  if [ "$tracker" = "jira" ]; then req DEPUTY_CLOUD_ID; req DEPUTY_USER_EMAIL; req DEPUTY_API_TOKEN; req DEPUTY_SITE_URL
  else req DEPUTY_GITHUB_REPO; fi
  printf "  tracker poll (%s)… " "$tracker"
  node "$TRACKER_CLI" list-ready >/dev/null 2>&1 && echo "ok ✓" || { echo "FAILED ✗ — check your credentials"; bad=1; }
  echo
  [ $bad -eq 0 ] && echo "All good — run: $DAEMON_BIN start" || echo "Fix the ✗ items above (npm run setup to rewrite .env)."
  return $bad
}

case "$1" in
  start)       start_daemon ;;
  doctor)      doctor ;;
  stop)        stop_daemon ;;
  restart)     [ -f "$DAEMON_PID_FILE" ] && stop_daemon; sleep 1; start_daemon ;;
  status)      status_daemon ;;
  foreground)  run_foreground ;;             # internal: supervised (launchd) foreground loop
  autostart-install)   autostart_install ;;  # run Deputy automatically at login (survives reboot)
  autostart-uninstall) autostart_uninstall ;;
  continue)    enqueue_continue "$2" "$3" ;;   # deputy continue <TICKET> "<what to do>"
  resume)      enqueue_resume "$2" "$3" ;;     # deputy resume <TICKET> "<answer>"  (answer a parked case)
  rerun)       enqueue_rerun "$2" ;;           # deputy rerun <TICKET>  (bring back a stopped/failed case)
  forget-ticket) forget_ticket "$2" ;;         # deputy forget-ticket <TICKET>  (delete worktree + state)
  stop-ticket) stop_ticket "$2" ;;             # cancel one in-flight ticket
  __run)       watch_and_process ;;            # internal: the backgrounded poll loop
  *) echo "Usage: $0 {start|stop|restart|status|doctor|autostart-install|autostart-uninstall|continue <TICKET> \"<prompt>\"|resume <TICKET> \"<answer>\"|rerun <TICKET>|stop-ticket <TICKET>|forget-ticket <TICKET>}"; exit 1 ;;
esac
