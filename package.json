{
  "name": "deputy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local daemon that watches a tracker (Jira / GitHub Issues) for AI-ready work items and resolves each with the Claude Agent SDK, with a web dashboard.",
  "bin": {
    "deputy": "bin/daemon"
  },
  "scripts": {
    "setup": "node lib/setup.mjs",
    "doctor": "bin/daemon doctor",
    "dashboard": "node server/server.mjs",
    "demo": "bin/seed-demo && DEPUTY_TMP=/tmp/deputy-demo DEPUTY_SITE_URL=https://acme.atlassian.net DEPUTY_DASHBOARD_PORT=4320 node server/server.mjs",
    "start": "bin/daemon start",
    "stop": "bin/daemon stop",
    "status": "bin/daemon status",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  }
}
